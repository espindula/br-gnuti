msgstr ""

#.  prev name
#.  node merged in this one
#. type: anchor{#1}
#: texinfo/upstream/texinfo.texi:22762
msgid "@code{makeinfo} in Emacs"
msgstr ""

#. type: anchor{#1}
#: texinfo/upstream/texinfo.texi:22762
msgid "@command{makeinfo} Advantages"
msgstr ""

#. type: cindex
#: texinfo/upstream/texinfo.texi:22762
#, no-wrap
msgid "Running @command{makeinfo} in Emacs"
msgstr ""

#. type: cindex
#: texinfo/upstream/texinfo.texi:22763
#, no-wrap
msgid "Running @command{texi2any} in Emacs"
msgstr ""

#. type: cindex
#: texinfo/upstream/texinfo.texi:22764
#, no-wrap
msgid "@command{makeinfo} inside Emacs"
msgstr ""

#. type: cindex
#: texinfo/upstream/texinfo.texi:22765
