msgid ""
"Prevents the first paragraph from being indented (default).  This option is "
"ignored by @command{makeinfo} if @code{@@paragraphindent asis} is in effect."
msgstr ""

#. type: code{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:23027
