#: texinfo/texinfo-ed.7.1-en_US.texi:20651
#, no-wrap
msgid "M-x texinfo-insert-@@code"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20654
msgid "Insert @code{@@code@{@}} and put the cursor between the braces."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20655
#, no-wrap
msgid "texinfo-insert-@@dfn"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20656
#, no-wrap
msgid "C-c C-c d"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20657
#, no-wrap
msgid "M-x texinfo-insert-@@dfn"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20660
msgid "Insert @code{@@dfn@{@}} and put the cursor between the braces."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20661
#, no-wrap
msgid "texinfo-insert-@@end"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20662
#, no-wrap
msgid "C-c C-c e"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20663
#, no-wrap
msgid "M-x texinfo-insert-@@end"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20668
msgid ""
"Insert @code{@@end} and attempt to insert the correct following word, such "
"as @samp{example} or @samp{table}.  (This command does not handle nested "
"lists correctly, but inserts the word appropriate to the immediately "
"preceding list.)"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20669
#, no-wrap
msgid "texinfo-insert-@@item"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20670
#, no-wrap
