#: texinfo/texinfo-ed.7.1-en_US.texi:6725
msgid ""
"And here is a two-column table with the same items and their @w{@@-commands}:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:6727
#, no-wrap
msgid "@@itemize"
msgstr ""

