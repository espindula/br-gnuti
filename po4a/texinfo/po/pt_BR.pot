msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20676
#, no-wrap
msgid "C-c C-c k"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20677
#, no-wrap
msgid "M-x texinfo-insert-@@kbd"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20680
msgid "Insert @code{@@kbd@{@}} and put the cursor between the braces."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20681
#, no-wrap
msgid "texinfo-insert-@@node"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20682
#, no-wrap
msgid "C-c C-c n"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20683
#, no-wrap
msgid "M-x texinfo-insert-@@node"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20688
msgid ""
"Insert @code{@@node} and a comment line listing the sequence for the `Next', "
"`Previous', and `Up' nodes.  Leave point after the @code{@@node}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20689
#, no-wrap
msgid "texinfo-insert-@@noindent"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20690
#, no-wrap
msgid "C-c C-c o"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20691
#, no-wrap
msgid "M-x texinfo-insert-@@noindent"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20694
msgid ""
"Insert @code{@@noindent} and put the cursor at the beginning of the next "
"line."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20695
#, no-wrap
msgid "texinfo-insert-dwim-@@ref"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20696
#, no-wrap
msgid "C-c C-c r"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20697
#, no-wrap
msgid "M-x texinfo-insert-dwim-@@ref"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20706
msgid ""
"This function and binding were added in Emacs 27.1.  Inserts one of "
"@code{@@pxref@{@}}, @code{@@xref@{@}}, or @code{@@ref@{@}} based on the text "
"around point; calling it near an unclosed preceding open parenthesis results "
"in @code{@@pxref@{@}}, at the beginning of a sentence or at "
"@code{(point-min)} yields @code{@@xref@{@}}, any other location (including "
"inside a word), will result in @code{@@ref@{@}}.  A numeric argument says "
"how many words the braces should surround.  Puts the cursor between the "
"braces."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20707
#, no-wrap
msgid "texinfo-insert-@@samp"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:20708
#, no-wrap
msgid "C-c C-c s"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20709
#, no-wrap
msgid "M-x texinfo-insert-@@samp"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20712
msgid "Insert @code{@@samp@{@}} and put the cursor between the braces."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20713
#, no-wrap
msgid "texinfo-insert-@@table"
