msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:20639
#, no-wrap
msgid "Commands, inserting them"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:20644
msgid ""
"Texinfo mode provides commands to insert various frequently used @@-commands "
"into the buffer.  You can use these commands to save keystrokes."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:20647
msgid ""
"The insert commands are invoked by typing @kbd{C-c} twice and then the first "
"letter of the @@-command:"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20649
#, no-wrap
msgid "texinfo-insert-@@code"
msgstr ""

