#: texinfo/texinfo-ed.7.1-en_US.texi:9551
msgid "Glyphs"
msgstr ""

#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9551
msgid "TeX and copyright"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9551
#, no-wrap
msgid "Glyphs for text"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9552
#, no-wrap
msgid "Textual glyphs"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9558
msgid ""
"Texinfo has support for a few additional glyphs that are commonly used in "
"printed text but not available in ASCII@.  Of course, there are many "
"thousands more.  It is possible to use Unicode characters as-is as far as "
"@code{texi2any} is concerned, but @TeX{} is not so lucky."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9560
#, no-wrap
msgid "@code{@@TeX @@LaTeX}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9562
msgid "@nodedescription The @TeX{} logos."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9562
#, no-wrap
msgid "@code{@@TeX}@{@} (@TeX{}) and @code{@@LaTeX}@{@} (@LaTeX{})"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9565
#: texinfo/texinfo-ed.7.1-en_US.texi:12221
#, no-wrap
msgid "tex"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9565
#, no-wrap
msgid "TeX"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9567
#, no-wrap
msgid "Logos, @TeX{}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9568
#, no-wrap
msgid "@TeX{} logo"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9569
#, no-wrap
msgid "@LaTeX{} logo"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9574
msgid ""
"Use the @code{@@TeX@{@}} command to generate `@TeX{}'.  In a printed manual, "
"this is a special logo that is different from three ordinary letters.  In "
"other output formats, it just looks like @samp{TeX}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9579
msgid ""
"Similarly, use the @code{@@LaTeX@{@}} command to generate `@LaTeX{}', which "
"is even more special in printed manuals (and different from the incorrect "
"@code{La@@TeX@{@}}.  In other output formats, the result is just "
"@samp{LaTeX}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9582
msgid ""
"The spelling of these commands is unusual for Texinfo, in that they use both "
"uppercase and lowercase letters."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9584
#, no-wrap
msgid "@code{@@copyright}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9586
msgid "@nodedescription The copyright symbol (c in a circle)."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9586
#, no-wrap
msgid "@code{@@copyright@{@}} (@copyright{})"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9589
msgid "copyright symbol"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9589
#, no-wrap
msgid "copyright"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9590
#, no-wrap
msgid "Copyright symbol"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9595
msgid ""
"Use the @code{@@copyright@{@}} command to generate the copyright symbol, "
"`@copyright{}'.  Where possible, this is a @samp{c} inside a circle; "
"otherwise this is @samp{(C)}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9598
msgid ""
"Legally, it's not necessary to use the copyright symbol; the English word "
"`Copyright' suffices, according to international treaty."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9600
#, no-wrap
msgid "@code{@@registeredsymbol}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9602
msgid "@nodedescription The registered symbol (R in a circle)."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9602
#, no-wrap
msgid "@code{@@registeredsymbol@{@}} (@registeredsymbol{})"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9605
msgid "registered symbol"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9605
#, no-wrap
msgid "registeredsymbol"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9606
#, no-wrap
msgid "Registered symbol"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9611
msgid ""
"Use the @code{@@registeredsymbol@{@}} command to generate the registered "
"symbol, `@registeredsymbol{}'.  Where possible, this is an @samp{R} inside a "
"circle; otherwise this is @samp{(R)}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9613
#, no-wrap
msgid "@code{@@dots}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9615
msgid "@nodedescription How to insert ellipses: @dots{} and @enddots{}"
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9615
#, no-wrap
msgid "@code{@@dots} (@dots{}) and @code{@@enddots} (@enddots{})"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9618
#, no-wrap
msgid "dots"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9619
#, no-wrap
msgid "enddots"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9620
#, no-wrap
msgid "Inserting dots"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9621
#, no-wrap
msgid "Inserting ellipsis"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9622
#, no-wrap
msgid "Dots, inserting"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9623
#, no-wrap
msgid "Ellipsis, inserting"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9626
msgid "Dots Bullets"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9634
msgid ""
"An @dfn{ellipsis} (a sequence of dots) would be spaced wrong when typeset as "
"a string of periods, so a special command is used in Texinfo: use the "
"@code{@@dots@{@}} command to generate a normal ellipsis, which is three dots "
"in a row, appropriately spaced @dots{} like so.  To emphasize: do not simply "
"write three periods in the input file; that could work in some output "
"formats, but would produce the wrong amount of space between the periods in "
"printed manuals."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9638
msgid ""
"The @code{@@enddots@{@}} command generates an end-of-sentence ellipsis, "
"which also has three dots, but with different spacing afterwards, @enddots{} "
"Look closely to see the difference."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9641
msgid "Here is an ellipsis: @dots{} Here are three periods in a row: ..."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9644
msgid ""
"In printed (and usually HTML) output, the three periods in a row are much "
"closer together than the dots in the ellipsis."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9646
#, no-wrap
msgid "@code{@@bullet}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9648
msgid "@nodedescription How to insert a bullet: @bullet{}"
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9648
#, no-wrap
msgid "@code{@@bullet} (@bullet{})"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9651
#, no-wrap
msgid "bullet"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9656
msgid ""
"Use the @code{@@bullet@{@}} command to generate a large round dot, or the "
"closest possible thing to one.  An asterisk can also be used.  Here is a "
"bullet: @bullet{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9660
msgid ""
"When you use @code{@@bullet} in @code{@@itemize}, you do not need to type "
"the braces, because @code{@@itemize} supplies them.  "
"(@pxref{@code{@@itemize}})."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9662
#, no-wrap
msgid "@code{@@euro}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9664
msgid "@nodedescription How to insert the euro currency symbol."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9664
#, no-wrap
msgid "@code{@@euro} (@euro{}): Euro Currency Symbol"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9667
#, no-wrap
msgid "euro"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9668
#, no-wrap
msgid "Euro symbol, producing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9673
msgid ""
"Use the @code{@@euro@{@}} command to generate `@euro{}'.  Where possible, "
"this is the symbol for the Euro currency.  Otherwise, the word @samp{Euro} "
"is used."
msgstr ""

#. type: pindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9674
#, no-wrap
msgid "feymr10"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9675
#, no-wrap
msgid "Euro font"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9682
msgid ""
"The Euro symbol does not exist in the standard @TeX{} fonts (which were "
"designed before the Euro was legislated into existence).  Therefore, @TeX{} "
"uses an additional font, named @code{feymr10} (along with other variables).  "
"It is freely available, of course; you can download it from "
"@url{http://ctan.org/pkg/eurosym}, among other places.  The distribution "
"includes installation instructions."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9684
#, no-wrap
msgid "@code{@@pounds}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9686
msgid "@nodedescription How to insert the pounds currency symbol."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9686
#, no-wrap
msgid "@code{@@pounds} (@pounds{}): Pounds Sterling"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9689
#, no-wrap
msgid "pounds"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9690
#, no-wrap
msgid "Pounds symbol"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9695
msgid ""
"Use the @code{@@pounds@{@}} command to generate `@pounds{}'.  Where "
"possible, this is the symbol for the pounds sterling British currency.  "
"Otherwise, it is @samp{#}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9697
#, no-wrap
msgid "@code{@@textdegree}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9699
msgid "@nodedescription How to insert the degrees symbol."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9699
#, no-wrap
msgid "@code{@@textdegree} (@textdegree{}): Degrees Symbol"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9702
#, no-wrap
msgid "textdegree"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9703
#, no-wrap
msgid "Degree symbol"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9708
msgid ""
"Use the @code{@@textdegree@{@}} command to generate `@textdegree{}'.  Where "
"possible, this is the normal symbol for degrees.  Otherwise, it is an "
"@samp{o}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9710
#, no-wrap
msgid "@code{@@minus}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9712
msgid "@nodedescription How to insert a minus sign."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9712
#, no-wrap
msgid "@code{@@minus} (@minus{}): Inserting a Minus Sign"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9715
#, no-wrap
msgid "minus"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9716
#, no-wrap
msgid "Minus sign"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9718
#, no-wrap
msgid "Em dash, compared to minus sign"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9719
#, no-wrap
msgid "Hyphen, compared to minus"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9724
msgid ""
"Use the @code{@@minus@{@}} command to generate a minus sign.  Where the "
"character encoding and font used in the output allow it, the symbol is the "
"customary length for a minus sign---a little longer than a hyphen, shorter "
"than an em-dash:"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:9727
#, no-wrap
msgid ""
"@samp{@minus{}} is a minus sign generated with @samp{@@minus@{@}},\n"
"\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:9729
#, no-wrap
msgid ""
"`-' is a hyphen generated with the character @samp{-},\n"
"\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:9731
#, no-wrap
msgid "`---' is an em-dash for text.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9736
msgid ""
"If you actually want to typeset some math that does a subtraction, it is "
"better to use @code{@@math}, as in @code{@@math@{a-b@}} (@pxref{Inserting "
"Math})."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9738
#, no-wrap
msgid "@code{@@geq @@leq}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9740
msgid "@nodedescription How to insert greater/less-than-or-equal signs."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9740
#, no-wrap
msgid "@code{@@geq} (@geq{}) and @code{@@leq} (@leq{}): Inserting Relations"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9743
msgid "geq leq"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9743
#, no-wrap
msgid "geq"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9744
#, no-wrap
msgid "leq"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9750
msgid ""
"Use the @code{@@geq@{@}} and @code{@@leq@{@}} commands to generate "
"greater-than-or-equal and less-than-equal-signs, `@geq{}' and `@leq{}'.  "
"When those symbols are not available, the ASCII sequences @samp{>=} and "
"@samp{<=} are output."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:9752
#: texinfo/texinfo-ed.7.1-en_US.texi:9754
#, no-wrap
msgid "Glyphs for Programming"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9754
msgid ""
"@nodedescription Indicating results of evaluation, expansion of macros, "
"errors, etc."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9756
#, no-wrap
msgid "Glyphs for programming"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9757
#, no-wrap
msgid "Examples, glyphs for"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9758
#, no-wrap
msgid "Programming, glyphs for"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9767
msgid ""
"In Texinfo, code is often illustrated in examples that are delimited by "
"@code{@@example} and @code{@@end example}.  In such examples, you can "
"indicate the results of evaluation or an expansion using @samp{@result{}} or "
"@samp{@expansion{}}.  Likewise, there are commands to insert glyphs to "
"indicate printed output, error messages, equivalence of expressions, the "
"location of point in an editor, and GUI operation sequences."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9771
msgid ""
"The glyph-insertion commands do not need to be used within an example, but "
"most often they are.  All glyph-insertion commands are followed by empty "
"braces."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9773
#: texinfo/texinfo-ed.7.1-en_US.texi:9775
#, no-wrap
msgid "Glyphs Summary"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9775
msgid "@nodedescription List of the glyph commands."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9778
msgid "Here is a summary of the glyph commands:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9780
#, no-wrap
msgid "@result{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9782
msgid "@code{@@result@{@}} indicates the result of an expression."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9783
#, no-wrap
msgid "@expansion{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9785
msgid "@code{@@expansion@{@}} indicates the results of a macro expansion."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9786
#, no-wrap
msgid "@print{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9788
msgid "@code{@@print@{@}} indicates printed output."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9789
#, no-wrap
msgid "@error{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9791
msgid "@code{@@error@{@}} indicates the following text is an error message."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9792
#, no-wrap
msgid "@equiv{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9794
msgid "@code{@@equiv@{@}} indicates the exact equivalence of two forms."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9795
#, no-wrap
msgid "@point{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9797
msgid "@code{@@point@{@}} shows the location of point."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:9798
#, no-wrap
msgid "@clicksequence{A @click{} B}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:9802
msgid ""
"@code{@@clicksequence@{A @@click@{@} B@}} indicates a GUI operation "
"sequence: first A, then clicking B, or choosing B from a menu, or otherwise "
"selecting it."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9805
#, no-wrap
msgid "@code{@@result}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9807
msgid "@nodedescription How to show the result of expression."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9807
#, no-wrap
msgid "@code{@@result@{@}} (@result{}): Result of an Expression"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9810
#, no-wrap
msgid "result"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9811
#, no-wrap
msgid "Result of an expression"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9812
#, no-wrap
msgid "Indicating evaluation"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9813
#, no-wrap
msgid "Evaluation glyph"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9814
#, no-wrap
msgid "Value of an expression, indicating"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9818
msgid ""
"Use the @code{@@result@{@}} command to indicate the result of evaluating an "
"expression."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9822
msgid ""
"The @code{@@result@{@}} command is displayed as @samp{@result{}}, either a "
"double stemmed arrow or (when that is not available) the ASCII sequence "
"@samp{=>}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9824
msgid "Thus, the following,"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:9828
#, no-wrap
msgid ""
"(cdr '(1 2 3))\n"
"    @result{} (2 3)\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9832
msgid "may be read as ``@code{(cdr '(1 2 3))} evaluates to @code{(2 3)}''."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9834
#, no-wrap
msgid "@code{@@expansion}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9836
msgid "@nodedescription How to indicate an expansion."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9836
#, no-wrap
msgid "@code{@@expansion@{@}} (@expansion{}): Indicating an Expansion"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9839
#: texinfo/texinfo-ed.7.1-en_US.texi:9841
#, no-wrap
msgid "expansion"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9839
#, no-wrap
msgid "Expansion, indicating"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9840
#, no-wrap
msgid "Macro expansion, indicating"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9846
msgid ""
"When an expression is a macro call, it expands into a new expression.  You "
"can indicate the result of the expansion with the @code{@@expansion@{@}} "
"command."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9850
msgid ""
"The @code{@@expansion@{@}} command is displayed as @samp{@expansion{}}, "
"either a long arrow with a flat base or (when that is not available) the "
"ASCII sequence @samp{==>}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9853
msgid "For example, the following"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:9861
#, no-wrap
msgid ""
"@@example lisp\n"
"(third '(a b c))\n"
"    @@expansion@{@} (car (cdr (cdr '(a b c))))\n"
"    @@result@{@} c\n"
"@@end example\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:9872
#, no-wrap
msgid ""
"(third '(a b c))\n"
"    @expansion{} (car (cdr (cdr '(a b c))))\n"
"    @result{} c\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9877
msgid "which may be read as:"
msgstr ""

#. type: quotation
#: texinfo/texinfo-ed.7.1-en_US.texi:9881
msgid ""
"@code{(third '(a b c))} expands to @code{(car (cdr (cdr '(a b c))))}; the "
"result of evaluating the expression is @code{c}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9886
msgid ""
"Often, as in this case, an example looks better if the "
"@code{@@expansion@{@}} and @code{@@result@{@}} commands are indented."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9888
#, no-wrap
msgid "@code{@@print}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9890
msgid "@nodedescription How to indicate generated output."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9890
#, no-wrap
msgid "@code{@@print@{@}} (@print{}): Indicating Generated Output"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9893
msgid "Print Glyph"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9893
#, no-wrap
msgid "print"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9894
#, no-wrap
msgid "Printed output, indicating"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9899
msgid ""
"Sometimes an expression will generate output during its execution.  You can "
"indicate such displayed output with the @code{@@print@{@}} command."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9903
msgid ""
"The @code{@@print@{@}} command is displayed as @samp{@print{}}, either a "
"horizontal dash butting against a vertical bar or (when that is not "
"available) the ASCII sequence @samp{-|}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9907
msgid ""
"In the following example, the printed text is indicated with "
"@samp{@print{}}, and the value of the expression follows on the last line."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:9914
#, no-wrap
msgid ""
"(progn (print 'foo) (print 'bar))\n"
"    @print{} foo\n"
"    @print{} bar\n"
"    @result{} bar\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9919
msgid "In a Texinfo source file, this example is written as follows:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:9928
#, no-wrap
msgid ""
"@@example lisp\n"
"(progn (print 'foo) (print 'bar))\n"
"    @@print@{@} foo\n"
"    @@print@{@} bar\n"
"    @@result@{@} bar\n"
"@@end example\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9932
#, no-wrap
msgid "@code{@@error}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9934
msgid "@nodedescription How to indicate an error message."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9934
#, no-wrap
msgid "@code{@@error@{@}} (@error{}): Indicating an Error Message"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9937
msgid "Error Glyph"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9937
#, no-wrap
msgid "Error message, indicating"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9938
#, no-wrap
msgid "error"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9942
msgid ""
"A piece of code may cause an error when you evaluate it.  You can designate "
"the error message with the @code{@@error@{@}} command."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9947
msgid ""
"The @code{@@error@{@}} command is displayed as @samp{@error{}}, either the "
"word `error' in a box in the printed output, the word error followed by an "
"arrow in other formats or (when no arrow is available)  @samp{error-->}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9950
#: texinfo/texinfo-ed.7.1-en_US.texi:9993
msgid "Thus,"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:9956
#, no-wrap
msgid ""
"@@example lisp\n"
"(+ 23 'x)\n"
"@@error@{@} Wrong type argument: integer-or-marker-p, x\n"
"@@end example\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:9964
#, no-wrap
msgid ""
"(+ 23 'x)\n"
"@error{} Wrong type argument: integer-or-marker-p, x\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9969
msgid ""
"This indicates that the following error message is printed when you evaluate "
"the expression:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:9972
#, no-wrap
msgid "Wrong type argument: integer-or-marker-p, x\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9975
msgid "The word @samp{@error{}} itself is not part of the error message."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:9977
#, no-wrap
msgid "@code{@@equiv}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9979
msgid "@nodedescription How to indicate equivalence."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:9979
#, no-wrap
msgid "@code{@@equiv@{@}} (@equiv{}): Indicating Equivalence"
msgstr ""

#.  oldname
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:9982
msgid "Equivalence"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:9982
#, no-wrap
msgid "Equivalence, indicating"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:9983
#, no-wrap
msgid "equiv"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:9991
msgid ""
"Sometimes two expressions produce identical results.  You can indicate the "
"exact equivalence of two forms with the @code{@@equiv@{@}} command.  The "
"@code{@@equiv@{@}} command is displayed as @samp{@equiv{}}, either a "
"standard mathematical equivalence sign (three parallel horizontal lines) or "
"(when that is not available) as the ASCII sequence @samp{==}."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:9998
#, no-wrap
msgid ""
"@@example lisp\n"
"(make-sparse-keymap) @@equiv@{@} (list 'keymap)\n"
"@@end example\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10005
#, no-wrap
msgid "(make-sparse-keymap) @equiv{} (list 'keymap)\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10010
msgid ""
"This indicates that evaluating @code{(make-sparse-keymap)} produces "
"identical results to evaluating @code{(list 'keymap)}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10012
#, no-wrap
msgid "@code{@@point}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10014
msgid "@nodedescription How to indicate the location of point."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:10014
#, no-wrap
msgid "@code{@@point@{@}} (@point{}): Indicating Point in a Buffer"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:10017
msgid "Point Glyph"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10017
#, no-wrap
msgid "Point, indicating in a buffer"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10018
#, no-wrap
msgid "point"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10024
msgid ""
"Sometimes you need to show an example of text in an Emacs buffer.  In such "
"examples, the convention is to include the entire contents of the buffer in "
"question between two lines of dashes containing the buffer name."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10029
msgid ""
"You can use the @samp{@@point@{@}} command to show the location of point in "
"the text in the buffer.  (The symbol for point, of course, is not part of "
"the text in the buffer; it indicates the place @emph{between} two characters "
"where point is located.)"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10033
msgid ""
"The @code{@@point@{@}} command is displayed as @samp{@point{}}, either a "
"pointed star or (when that is not available) the ASCII sequence @samp{-!-}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10036
msgid ""
"The following example shows the contents of buffer @file{foo} before and "
"after evaluating a Lisp command to insert the word @code{changed}."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10042
#, no-wrap
msgid ""
"---------- Buffer: foo ----------\n"
"This is the @point{}contents of foo.\n"
"---------- Buffer: foo ----------\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10053
#, no-wrap
msgid ""
"(insert \"changed \")\n"
"    @result{} nil\n"
"---------- Buffer: foo ----------\n"
"This is the changed @point{}contents of foo.\n"
"---------- Buffer: foo ----------\n"
"\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10058
msgid "In a Texinfo source file, the example is written like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10064
#, no-wrap
msgid ""
"@@example\n"
"---------- Buffer: foo ----------\n"
"This is the @@point@{@}contents of foo.\n"
"---------- Buffer: foo ----------\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10071
#, no-wrap
msgid ""
"(insert \"changed \")\n"
"    @@result@{@} nil\n"
"---------- Buffer: foo ----------\n"
"This is the changed @@point@{@}contents of foo.\n"
"---------- Buffer: foo ----------\n"
"@@end example\n"
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:10074
#: texinfo/texinfo-ed.7.1-en_US.texi:10076
#, no-wrap
msgid "Click Sequences"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10076
msgid "@nodedescription Inserting GUI usage sequences."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10078
#, no-wrap
msgid "Click sequences"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10079
#, no-wrap
msgid "Sequence of clicks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10080
#, no-wrap
msgid "GUI click sequence"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10082
#, no-wrap
msgid "clicksequence"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10087
msgid ""
"When documenting graphical interfaces, it is necessary to describe sequences "
"such as `Click on @samp{File}, then choose @samp{Open}, then @dots{}'.  "
"Texinfo offers commands @code{@@clicksequence} and @code{click} to represent "
"this, typically used like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10090
#, no-wrap
msgid "@dots{} @@clicksequence@{File @@click@{@} Open@} @dots{}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10094
msgid "which produces:"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:10097
#, no-wrap
msgid "@dots{} @clicksequence{File @click{} Open} @dots{}\n"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10099
#, no-wrap
msgid "click"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10100
#, no-wrap
msgid "arrow"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10104
msgid ""
"The @code{@@click} command produces a right arrow by default; this glyph is "
"also available independently via the command @code{@@arrow@{@}}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10105
#, no-wrap
msgid "clickstyle"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10111
msgid ""
"You can change the glyph produced by @code{@@click} with the command "
"@code{@@clickstyle}, which takes a command name as its single argument on "
"the rest of the line, much like @code{@@itemize} and friends "
"(@pxref{@code{@@itemize}}).  The command should produce a glyph, and the "
"usual empty braces @samp{@{@}} are omitted.  Here's an example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10115
#, no-wrap
msgid ""
"@@clickstyle @@result\n"
"@dots{} @@clicksequence@{File @@click@{@} Open@} @dots{}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10119
msgid "now produces:"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:10123
#, no-wrap
msgid ""
"@clickstyle @result\n"
"@dots{} @clicksequence{File @click{} Open} @dots{}\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10126
#, no-wrap
msgid "Inserting Unicode"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10128
msgid "@nodedescription Inserting a Unicode character by code point."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10128
#, no-wrap
msgid "Inserting Unicode: @code{@@U}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10130
#, no-wrap
msgid "Unicode character, inserting"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10131
#, no-wrap
msgid "Code point of Unicode character, inserting by"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10132
#, no-wrap
msgid "U"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10137
msgid ""
"The command @code{@@U@{@var{hex}@}} inserts a representation of the Unicode "
"character U+@var{hex}.  For example, @code{@@U@{0132@}} inserts the Dutch "
"`IJ' ligature (`@U{0132}')."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10142
msgid ""
"The @var{hex} value should be at least four hex digits; leading zeros are "
"@emph{not} added.  In general, @var{hex} must specify a valid normal Unicode "
"character; e.g., U+10FFFF (the very last code point) is invalid by "
"definition, and thus cannot be inserted this way."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10143
#, no-wrap
msgid "ASCII, source document portability using"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10147
msgid ""
"@code{@@U} is useful for inserting occasional glyphs for which Texinfo has "
"no dedicated command, while allowing the Texinfo source to remain purely "
"7-bit ASCII for maximum portability."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10148
#, no-wrap
msgid "Unicode and @TeX{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10159
msgid ""
"This command has many limitations---the same limitations as inserting "
"Unicode characters in UTF-8 or another binary form.  First and most "
"importantly, @TeX{} knows nothing about most of Unicode.  Supporting "
"specific additional glyphs upon request is possible, but it's not viable for "
"@file{texinfo.tex} to support whole additional scripts (Japanese, Urdu, "
"@dots{}).  The @code{@@U} command does nothing to change this.  If the "
"specified character is not supported in @TeX{}, an error is given.  @LaTeX{} "
"output has more possibilities regarding UTF-8, but could require extra code "
"to load fonts and declare how UTF-8 characters are output.  "
"(@xref{@code{@@documentencoding}}.)"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10160
#, no-wrap
msgid "Entity reference in HTML et al."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10161
#, no-wrap
msgid "@samp{&#x@var{hex};}, output from @code{@@U}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10167
msgid ""
"In HTML and DocBook, the output from @code{@@U} is always an entity "
"reference of the form @samp{&#x@var{hex};}, as in @samp{&#x0132;} for the "
"example above.  This should work even when an HTML document uses some other "
"encoding (say, Latin@tie{}1) and the given character is not supported in "
"that encoding."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10171
msgid ""
"In Info and plain text, if the output encoding is not UTF-8, the output is "
"the ASCII sequence @samp{U+@var{hex}}, as in the six ASCII characters "
"@samp{U+0132} for the example above."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10173
#, no-wrap
msgid "Breaks"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10175
msgid "@nodedescription Forcing or preventing line and page breaks."
msgstr ""

#. type: chapter
#: texinfo/texinfo-ed.7.1-en_US.texi:10175
#, no-wrap
msgid "Forcing and Preventing Breaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10177
#, no-wrap
msgid "Forcing line and page breaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10178
#, no-wrap
msgid "Making line and page breaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10179
#, no-wrap
msgid "Preventing line and page breaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10180
#, no-wrap
msgid "Line breaks @subentry awkward"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10181
#, no-wrap
msgid "Page breaks, awkward"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10186
msgid ""
"Line and page breaks can sometimes occur in the `wrong' place in one or "
"another form of output.  It's up to you to ensure that text looks right in "
"all the output formats."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10192
msgid ""
"For example, in a printed manual, page breaks may occur awkwardly in the "
"middle of an example; to prevent this, you can hold text together using a "
"grouping command that keeps the text from being split across two pages.  "
"Conversely, you may want to force a page break where none would normally "
"occur."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10195
msgid ""
"You can use the break, break prevention, or pagination commands to fix "
"problematic line and page breaks."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10197
#: texinfo/texinfo-ed.7.1-en_US.texi:10199
#, no-wrap
msgid "Break Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10199
msgid "@nodedescription Summary of break-related commands."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10202
msgid "The break commands create or allow line and paragraph breaks:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10204
#: texinfo/texinfo-ed.7.1-en_US.texi:18520
#, no-wrap
msgid "@@*"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10206
msgid "Force a line break."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10207
#: texinfo/texinfo-ed.7.1-en_US.texi:19583
#, no-wrap
msgid "@@sp @var{n}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10209
msgid "Skip @var{n} blank lines."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10210
#: texinfo/texinfo-ed.7.1-en_US.texi:10305
#: texinfo/texinfo-ed.7.1-en_US.texi:18527
#, no-wrap
msgid "@@-"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10212
msgid "Insert a discretionary hyphen."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10213
#: texinfo/texinfo-ed.7.1-en_US.texi:10313
#: texinfo/texinfo-ed.7.1-en_US.texi:19136
#, no-wrap
msgid "@@hyphenation@{@var{hy-phen-a-ted words}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10215
msgid "Define hyphen points in @var{hy-phen-a-ted words}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10218
msgid "These commands hold text together on a single line:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10220
#: texinfo/texinfo-ed.7.1-en_US.texi:19805
#, no-wrap
msgid "@@w@{@var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10222
msgid "Prevent @var{text} from being split and hyphenated across two lines."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10223
#: texinfo/texinfo-ed.7.1-en_US.texi:19687
#, no-wrap
msgid "@@tie@{@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10225
msgid "Insert a normal interword space at which a line break may not occur."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10229
msgid ""
"The pagination commands apply only to printed output, since other output "
"formats do not have pages."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10231
#: texinfo/texinfo-ed.7.1-en_US.texi:19396
#, no-wrap
msgid "@@page"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10233
msgid "Start a new page."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10234
#: texinfo/texinfo-ed.7.1-en_US.texi:19093
#, no-wrap
msgid "@@group"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10236
msgid "Hold text together that must appear on one page."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10237
#, no-wrap
msgid "@@need @var{mils}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10239
msgid "Start a new page if not enough space on this one."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10242
#, no-wrap
msgid "Line Breaks"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10244
msgid "@nodedescription Forcing line breaks."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10244
#, no-wrap
msgid "@code{@@*} and @code{@@/}: Generate and Allow Line Breaks"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10246
#, no-wrap
msgid "* @r{(force line break)}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10247
#, no-wrap
msgid "/ @r{(allow line break)}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10249
#, no-wrap
msgid "*"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10250
#, no-wrap
msgid "/"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10253
#, no-wrap
msgid "Line breaks @subentry controlling"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10254
#, no-wrap
msgid "Controlling line breaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10255
#, no-wrap
msgid "Breaks in a line"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10256
#, no-wrap
msgid "Force line break"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10257
#, no-wrap
msgid "Allow line break"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10261
msgid ""
"The @code{@@*} command forces a line break in all output formats.  The "
"@code{@@/} command allows a line break (printed manual only)."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10263
msgid "Here is an example with @code{@@*}:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10266
#, no-wrap
msgid "This sentence is broken @@*into two lines.\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10274
#, no-wrap
msgid ""
"This sentence is broken\n"
"into two lines.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10282
msgid ""
"The @code{@@/} command can be useful within long URLs or other identifiers "
"where @TeX{} can't find a good place to break.  @TeX{} will automatically "
"break URLs at the natural places (@pxref{URL Line Breaking}), so only use "
"@code{@@/} if you need it.  @code{@@/} has no effect on the other output "
"formats."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10284
#, no-wrap
msgid "@code{@@- @@hyphenation}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10286
msgid "@nodedescription Helping @TeX{} with hyphenation points."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10286
#, no-wrap
msgid "@code{@@-} and @code{@@hyphenation}: Hyphenation in Printed Output"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:10289
msgid "- and hyphenation"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10289
#, no-wrap
msgid "@sortas{-} - @r{(discretionary hyphen)}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10291
#, no-wrap
msgid "@sortas{-} -"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10293
#, no-wrap
msgid "hyphenation"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10294
#, no-wrap
msgid "Hyphenation, helping @TeX{} do"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10295
#, no-wrap
msgid "Fine-tuning, and hyphenation"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10303
msgid ""
"Although @TeX{}'s hyphenation algorithm is generally pretty good, it does "
"miss useful hyphenation points from time to time.  (Or, far more rarely, "
"insert an incorrect hyphenation.)  So, for documents with an unusual "
"vocabulary or when fine-tuning for a printed edition, you may wish to "
"specify hyphenation points explicitly.  Texinfo supports two commands for "
"this:"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10312
msgid ""
"Insert a discretionary hyphen, i.e., a place where a word can be broken "
"across lines with a hyphen.  This is especially useful when you notice that "
"an overfull hbox is due to @TeX{} missing a hyphenation (@pxref{Overfull "
"hboxes}).  @TeX{} will not insert any hyphenation points itself into a word "
"containing @code{@@-}."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10315
msgid "Give hyphenation points for certain words.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10317
#, no-wrap
msgid "@@hyphenation@{man-u-script man-u-scripts@}\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10322
msgid ""
"@TeX{} only uses the specified hyphenation points when the words match "
"exactly, so give all necessary variants, such as plurals."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10326
msgid ""
"Non-printed output is not hyphenated, so none of these commands have any "
"effect in other output formats."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10328
#, no-wrap
msgid "@code{@@allowcodebreaks}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10330
msgid "@nodedescription Controlling line breaks within @@code text."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10330
#, no-wrap
msgid "@code{@@allowcodebreaks}: Control Line Breaks in @code{@@code}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10333
#, no-wrap
msgid "allowcodebreaks"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10334
#, no-wrap
msgid "Breaks, within @code{@@code}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10335
#, no-wrap
msgid "@sortas{-} -, breakpoint within @code{@@code}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10336
#, no-wrap
msgid "Hyphen, breakpoint within @code{@@code}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10337
#, no-wrap
msgid "Dash, breakpoint within @code{@@code}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10338
#, no-wrap
msgid "_, breakpoint within @code{@@code}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10339
#, no-wrap
msgid "Underscore, breakpoint within @code{@@code}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10345
msgid ""
"Ordinarily, @TeX{} considers breaking lines at @samp{-} and @samp{_} "
"characters within @code{@@code} and related commands "
"(@pxref{@code{@@code}}), more or less as if they were ``empty'' hyphenation "
"points."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10351
msgid ""
"This is necessary since many manuals, especially for Lisp-family languages, "
"must document very long identifiers.  On the other hand, some manuals don't "
"have this problem, and you may not wish to allow a line break at the "
"underscore in, for example, @code{SIZE_MAX}, or even worse, after any of the "
"four underscores in @code{__typeof__}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10353
msgid "So Texinfo provides this command:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10356
#, no-wrap
msgid "@@allowcodebreaks false\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10362
msgid ""
"@code{@@code}.  You can go back to allowing such breaks with "
"@code{@@allowcodebreaks true}.  Write these commands on lines by themselves."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10366
msgid ""
"These commands can be given anywhere in the document.  For example, you may "
"have just one problematic paragraph where you need to turn off the breaks, "
"but want them in general, or vice versa."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10368
msgid "This command has no effect except in @TeX{} output."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10370
#, no-wrap
msgid "@code{@@w}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10372
msgid "@nodedescription Preventing unwanted line breaks in text."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10372
#, no-wrap
msgid "@code{@@w}@{@var{text}@}: Prevent Line Breaks"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10375
#, no-wrap
msgid "w"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10376
#, no-wrap
msgid "Line breaks, preventing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10380
msgid ""
"@code{@@w@{@var{text}@}} outputs @var{text}, while prohibiting line breaks "
"within @var{text}."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10381
#, no-wrap
msgid "Non-breakable space, fixed"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10382
#, no-wrap
msgid "Unbreakable space, fixed"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10385
msgid ""
"Thus, you can use @code{@@w} to produce a non-breakable space, fixed at the "
"width of a normal interword space:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10388
#, no-wrap
msgid "@@w@{ @} @@w@{ @} @@w@{ @} indentation.\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:10394
#, no-wrap
msgid "@w{ } @w{ } @w{ } indentation.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10401
msgid ""
"The space from @code{@@w@{@w{ }@}}, as well as being non-breakable, also "
"will not stretch or shrink.  Sometimes that is what you want, for instance "
"if you're doing manual indenting.  However, usually you want a normal "
"interword space that does stretch and shrink (in the printed output); for "
"that, see the @code{@@tie} command in the next section."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10402
#, no-wrap
msgid "Hyphenation, preventing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10406
msgid ""
"In printed output, you can also use the @code{@@w} command to prevent a long "
"name or phrase being automatically hyphenated, for example if it happens to "
"fall near the end of a line."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10407
#, no-wrap
msgid "Keyword expansion, preventing"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10408
#, no-wrap
msgid "Version control keywords, preventing expansion of"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10409
#, no-wrap
msgid "$Id expansion, preventing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10414
msgid ""
"You can also use @code{@@w} to avoid unwanted keyword expansion in source "
"control systems.  For example, to literally write @t{@w{$}Id$} in your "
"document, use @code{@@w@{$@}Id$}.  This trick isn't effective for output "
"files in some output formats, though."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10416
#, no-wrap
msgid "@code{@@tie}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10418
msgid "@nodedescription Inserting an unbreakable but varying space."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10418
#, no-wrap
msgid "@code{@@tie@{@}}: Inserting an Unbreakable Space"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10421
#, no-wrap
msgid "tie"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10422
#, no-wrap
msgid "Tied space"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10423
#, no-wrap
msgid "Non-breakable space, variable"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10424
#, no-wrap
msgid "Unbreakable space, variable"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10430
msgid ""
"The @code{@@tie@{@}} command produces a normal interword space at which a "
"line break may not occur.  Always write it with following (empty)  braces, "
"as usual for commands used within a paragraph.  Here's an example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10433
#, no-wrap
msgid "@@TeX@{@} was written by Donald E.@@tie@{@}Knuth.\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:10439
#, no-wrap
msgid "@TeX{} was written by Donald E.@tie{}Knuth.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10443
msgid ""
"There are two important differences between @code{@@tie@{@}} and "
"@code{@@w@{@w{ }@}}:"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:10449
msgid ""
"The space produced by @code{@@tie@{@}} will stretch and shrink slightly "
"along with the normal interword spaces in the paragraph; the space produced "
"by @code{@@w@{@w{ }@}} will not vary."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:10454
msgid ""
"@code{@@tie@{@}} allows hyphenation of the surrounding words, while "
"@code{@@w@{@w{ }@}} inhibits hyphenation of those words (for @TeX{}nical "
"reasons, namely that it produces an @samp{\\hbox})."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10458
#, no-wrap
msgid "@code{@@sp}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10460
msgid "@nodedescription Inserting blank lines."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10460
#, no-wrap
msgid "@code{@@sp} @var{n}: Insert Blank Lines"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10464
#, no-wrap
msgid "Space, inserting vertical"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10465
#, no-wrap
msgid "Blank lines"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10466
#, no-wrap
msgid "Line spacing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10471
msgid ""
"A line beginning with and containing only @code{@@sp @var{n}} generates "
"@var{n} blank lines of space.  @code{@@sp} also forces a paragraph break.  "
"For example,"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10478
msgid "generates two blank lines."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10480
msgid "The @code{@@sp} command is most often used in the title page."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10482
#, no-wrap
msgid "@code{@@page}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10484
msgid "@nodedescription Forcing the start of a new page."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10484
#, no-wrap
msgid "@code{@@page}: Start a New Page"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10487
#, no-wrap
msgid "page"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10488
#, no-wrap
msgid "Page breaks, forcing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10495
msgid ""
"A line containing only @code{@@page} starts a new page in a printed manual.  "
"In other formats, without the concept of pages, it starts a new paragraph.  "
"A @code{@@page} command is often used in the @code{@@titlepage} section of a "
"Texinfo file to start the copyright page."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10497
#, no-wrap
msgid "@code{@@group}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10499
msgid "@nodedescription Preventing unwanted page breaks."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10499
#, no-wrap
msgid "@code{@@group}: Prevent Page Breaks"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10502
#, no-wrap
msgid "group"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10503
#, no-wrap
msgid "Group (hold text together vertically)"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10504
#, no-wrap
msgid "Holding text together vertically"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10505
#, no-wrap
msgid "Vertically holding text together"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10513
msgid ""
"The @code{@@group} command is used to hold an example together on one page.  "
"Use it inside an @code{@@example} or similar construct to begin an "
"unsplittable vertical group, which will appear entirely on one page in the "
"printed output.  Terminate the group by a line containing only @code{@@end "
"group}.  This command has an effect in @TeX{} output only."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10517
msgid ""
"The @code{@@group} and @code{@@end group} commands need to be inside the "
"@code{@@example} and @code{@@end example} commands, thus:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10525
#, no-wrap
msgid ""
"@@example\n"
"@@group\n"
"@dots{}\n"
"@@end group\n"
"@@end example\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10534
msgid ""
"Although @code{@@group} would make sense conceptually in a wide variety of "
"contexts, its current implementation works only within @code{@@example} and "
"variants, and within @code{@@display}, @code{@@format}, @code{@@flushleft} "
"and @code{@@flushright}.  @xref{Quotations and Examples}.  (What all these "
"commands have in common is that each line of input produces a line of "
"output.)"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10550
#, no-wrap
msgid "@code{@@need}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10552
msgid "@nodedescription Another way to prevent unwanted page breaks."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10552
#, no-wrap
msgid "@code{@@need @var{mils}}: Prevent Page Breaks"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10555
#, no-wrap
msgid "need"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10556
#, no-wrap
msgid "Need space at page bottom"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10557
#, no-wrap
msgid "Mils, argument to @code{@@need}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10564
msgid ""
"A line containing only @code{@@need @var{n}} starts a new page in a printed "
"manual if fewer than @var{n} mils (thousandths of an inch)  remain on the "
"current page.  Do not use braces around the argument @var{n}.  The "
"@code{@@need} command has no effect on other output formats since they are "
"not paginated."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10569
msgid ""
"This paragraph is preceded by a @code{@@need} command that starts a new page "
"in printed output if fewer than 800 mils (eight-tenths inch)  remain on the "
"page.  It looks like this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10574
#, no-wrap
msgid ""
"@@need 800\n"
"This paragraph is preceded by @dots{}\n"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10577
#, no-wrap
msgid "Orphans, preventing"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10580
msgid ""
"The @code{@@need} command is useful for preventing orphans: single lines at "
"the bottoms of printed pages."
msgstr ""

#. type: subsubheading
#: texinfo/texinfo-ed.7.1-en_US.texi:10582
#: texinfo/texinfo-ed.7.1-en_US.texi:10584
#: texinfo/texinfo-ed.7.1-en_US.texi:20072
#, no-wrap
msgid "Definition Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10584
msgid "@nodedescription Describing functions and the like uniformly."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10585
#, no-wrap
msgid "Definition commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10590
msgid ""
"The @code{@@deffn} command and the other @dfn{definition commands} enable "
"you to describe functions, variables, macros, commands, user options, "
"special forms and other entities in a uniform format."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10595
msgid ""
"In the output, the name of the entity is shown with any arguments, along "
"with the entity category ---`Function', `Variable', or whatever.  "
"Underneath, the body of the definition is indented.  The name of the entity "
"is also entered into the appropriate index."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10599
msgid ""
"All the definition commands follow a similar format.  This chapter starts by "
"describing @code{@@deffn} before detailing all the other definition commands."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10601
#, no-wrap
msgid "Def Cmd Template"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10603
msgid "@nodedescription Writing descriptions using definition commands."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10603
#, no-wrap
msgid "The Template for a Definition"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10604
#, no-wrap
msgid "Definition template"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10605
#, no-wrap
msgid "Template for a definition"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10612
#, no-wrap
msgid ""
"@@deffn @var{category} @var{name} @var{arguments}@dots{}\n"
"@var{body-of-definition}\n"
"@@end deffn\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10624
msgid ""
"The @code{@@deffn} command is used for definitions of entities that resemble "
"functions---entities that may take arguments.  Write the @code{@@deffn} "
"command at the beginning of a line and follow it on the same line by the "
"category of the entity, the name of the entity itself, and its arguments (if "
"any).  Then write the body of the definition on succeeding lines.  Finally, "
"end the definition with an @code{@@end deffn} command written on a line of "
"its own."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10636
#, no-wrap
msgid ""
"@@deffn Command forward-word count\n"
"This command moves point forward @@var@{count@} words\n"
"(or backward if @@var@{count@} is negative). @dots{}\n"
"@@end deffn\n"
msgstr ""

#. type: deffn
#: texinfo/texinfo-ed.7.1-en_US.texi:10643
#, no-wrap
msgid "Command forward-word count"
msgstr ""

#. type: deffn
#: texinfo/texinfo-ed.7.1-en_US.texi:10646
msgid ""
"This command moves point forward @var{count} words (or backward if "
"@var{count} is negative). @dots{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10652
msgid ""
"Capitalize the category name like a title.  If the name of the category "
"contains spaces, as in the phrase `Interactive Command', enclose it in "
"braces.  For example:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10658
#, no-wrap
msgid ""
"@@deffn @{Interactive Command@} isearch-forward\n"
"@dots{}\n"
"@@end deffn\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10668
msgid ""
"Otherwise, the second word will be mistaken for the name of the entity.  As "
"a general rule, when any of the arguments in the heading line @emph{except} "
"the last one are more than one word, you need to enclose them in braces.  "
"This may also be necessary if the text contains commands, for example, "
"@samp{@{declaraci@@'on@}} if you are writing in Spanish."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10673
msgid ""
"The category is output in a different location for different output "
"formats.  For example, in the Info file, the category appears at the "
"beginning of the first line of the definition.  With @TeX{} output, the "
"category is printed next to the right margin."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10675
msgid "@code{@@deffn} enters names into the index of functions."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10683
msgid ""
"Three predefined, specialized variations of @code{@@deffn} (@code{@@defun}, "
"@code{@@defmac}, and @code{@@defspec}) specify the category for you: "
"``Function'', ``Macro'', and ``Special Form'' respectively.  (In Lisp, a "
"special form is an entity much like a function.)  Similarly, the general "
"@code{@@defvr} command is accompanied by several specialized variations for "
"describing particular kinds of variables."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10685
#, no-wrap
msgid "Def Cmd Continuation Lines"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10687
msgid "@nodedescription Continuing the heading over source lines."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10687
#, no-wrap
msgid "Definition Command Continuation Lines"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10688
#, no-wrap
msgid "Continuation lines in definition commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10689
#, no-wrap
msgid "Definition command headings, continuing"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10690
#, no-wrap
msgid "@sortas{@@} @samp{@@} as continuation in definition commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10696
msgid ""
"The heading line of a definition command can get very long.  Therefore, "
"Texinfo has a special syntax allowing them to be continued over multiple "
"lines of the source file: a lone @samp{@@} at the end of each line to be "
"continued.  Here's an example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10702
#, no-wrap
msgid ""
"@@defun fn-name @@\n"
"  arg1 arg2 arg3\n"
"This is the basic continued defun.\n"
"@@end defun\n"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:10706
#, no-wrap
msgid "fn-name   arg1 arg2 arg3"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:10708
msgid "This is the basic continued defun."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10713
msgid ""
"As you can see, the continued lines are combined, as if they had been typed "
"on one source line."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10717
msgid ""
"Although this example only shows a one-line continuation, continuations may "
"extend over any number of lines, in the same way; put an @code{@@} at the "
"end of each line to be continued."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10718
#, no-wrap
msgid "Whitespace, collapsed around continuations"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10719
#, no-wrap
msgid "Collapsing whitespace around continuations"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10724
msgid ""
"In general, any number of spaces or tabs before the @code{@@} continuation "
"character are collapsed into a single space.  There is one exception: the "
"Texinfo processors will not fully collapse whitespace around a continuation "
"inside braces.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10728
#, no-wrap
msgid ""
"@@deffn @{Category @@\n"
"  Name@} @dots{}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10733
msgid ""
"and `Name'.  To avoid this, elide the unwanted whitespace in your input, or "
"put the continuation @code{@@} outside braces."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10738
msgid ""
"@code{@@} does not function as a continuation character in @emph{any} other "
"context.  Ordinarily, @samp{@@} followed by a whitespace character (space, "
"tab, newline) produces a normal interword space (@pxref{Multiple Spaces})."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10740
#, no-wrap
msgid "Optional Arguments"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10742
msgid "@nodedescription Handling optional and repeated arguments."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10742
#, no-wrap
msgid "Optional and Repeated Arguments"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10743
#, no-wrap
msgid "Optional and repeated arguments"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10744
#, no-wrap
msgid "Repeated and optional arguments"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10745
#, no-wrap
msgid "Arguments, repeated and optional"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10746
#, no-wrap
msgid "Syntax, optional & repeated arguments"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10747
#, no-wrap
msgid "Meta-syntactic chars for arguments"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10754
msgid ""
"Some entities take optional or repeated arguments.  One convention for "
"indicating these uses square brackets and ellipses: an argument enclosed "
"within square brackets is optional, and an argument followed by an ellipsis "
"is optional and may be repeated more than once."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10759
msgid ""
"Thus, [@var{optional-arg}] means that @var{optional-arg} is optional and "
"@var{repeated-args}@code{@dots{}} stands for zero or more arguments.  "
"Parentheses are used when several arguments are grouped into additional "
"levels of list structure in Lisp."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10762
msgid ""
"Here is the definition line of an example of an imaginary (complicated) "
"special form:"
msgstr ""

#. type: defspec
#: texinfo/texinfo-ed.7.1-en_US.texi:10764
#, no-wrap
msgid "foobar (var [from to [inc]]) body@dots{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10775
msgid ""
"In this example, the arguments @var{from} and @var{to} are optional, but "
"must both be present or both absent.  If they are present, @var{inc} may "
"optionally be specified as well.  These arguments are grouped with the "
"argument @var{var} into a list, to distinguish them from @var{body}, which "
"includes all remaining elements of the form."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10778
msgid ""
"In a Texinfo source file, this @code{@@defspec} line is written like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10781
#, no-wrap
msgid "@@defspec foobar (var [from to [inc]]) body@@dots@{@}\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10784
#, no-wrap
msgid "No Space After Definition Name"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10786
msgid "@nodedescription How to omit space after name."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10786
#, no-wrap
msgid "Omitting the Space After a Definition Name"
msgstr ""

#. type: vindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10788
#, no-wrap
msgid "txidefnamenospace"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10793
msgid ""
"As a matter of style or as demanded by the syntax of a programming language, "
"you may wish to omit any space after a name in a definition, occurring "
"before an opening bracket.  To do this, set the @samp{txidefnamenospace} "
"flag (@pxref{@code{@@set @@value}}).  For example, this input"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:10799
#, no-wrap
msgid ""
"@@set txidefnamenospace\n"
"@@deffn Builtin index (string, substring)\n"
"@@dots@{@}\n"
"@@end deffn\n"
msgstr ""

#. type: deffn
#: texinfo/texinfo-ed.7.1-en_US.texi:10804
#, no-wrap
msgid "Builtin index (string, substring)"
msgstr ""

#. type: deftypeivar
#: texinfo/texinfo-ed.7.1-en_US.texi:10806
#: texinfo/texinfo-ed.7.1-en_US.texi:10995
#: texinfo/texinfo-ed.7.1-en_US.texi:11238
#: texinfo/texinfo-ed.7.1-en_US.texi:11334
#: texinfo/texinfo-ed.7.1-en_US.texi:11357
#: texinfo/texinfo-ed.7.1-en_US.texi:11380
#: texinfo/texinfo-ed.7.1-en_US.texi:11403
msgid "@dots{}"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10810
#, no-wrap
msgid "@code{@@deffnx}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10812
msgid "@nodedescription Group two or more `first' lines."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10812
#, no-wrap
msgid "@code{@@deffnx}, et al.: Two or More `First' Lines"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10815
#, no-wrap
msgid "deffnx"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10816
#, no-wrap
msgid "Two `First' Lines for @code{@@deffn}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10817
#, no-wrap
msgid "Grouping two definitions together"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10818
#, no-wrap
msgid "Definitions grouped together"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10823
msgid ""
"To create two or more `first' or header lines for a definition, follow the "
"first @code{@@deffn} line by a line beginning with @code{@@deffnx}."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10833
#, no-wrap
msgid ""
"@@deffn @{Interactive Command@} isearch-forward\n"
"@@deffnx @{Interactive Command@} isearch-backward\n"
"These two search commands are similar except @dots{}\n"
"@@end deffn\n"
msgstr ""

#. type: deffn
#: texinfo/texinfo-ed.7.1-en_US.texi:10839
#, no-wrap
msgid "{Interactive Command} isearch-forward"
msgstr ""

#. type: deffnx
#: texinfo/texinfo-ed.7.1-en_US.texi:10840
#, no-wrap
msgid "{Interactive Command} isearch-backward"
msgstr ""

#. type: deffn
#: texinfo/texinfo-ed.7.1-en_US.texi:10842
msgid "These two search commands are similar except @dots{}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10844
#, no-wrap
msgid "defcvx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10845
#, no-wrap
msgid "defivarx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10846
#, no-wrap
msgid "defmacx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10847
#, no-wrap
msgid "defmethodx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10848
#, no-wrap
msgid "defoptx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10849
#, no-wrap
msgid "defopx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10850
#, no-wrap
msgid "defspecx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10851
#, no-wrap
msgid "deftpx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10852
#, no-wrap
msgid "deftypecvx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10853
#, no-wrap
msgid "deftypefnx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10854
#, no-wrap
msgid "deftypefunx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10855
#, no-wrap
msgid "deftypeivarx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10856
#, no-wrap
msgid "deftypemethodx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10857
#, no-wrap
msgid "deftypeopx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10858
#, no-wrap
msgid "deftypevarx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10859
#, no-wrap
msgid "deftypevrx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10860
#, no-wrap
msgid "defunx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10861
#, no-wrap
msgid "defvarx"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10862
#, no-wrap
msgid "defvrx"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10865
msgid ""
"Each definition command has an `x' form: @code{@@defunx}, @code{@@defvrx}, "
"@code{@@deftypefunx}, etc."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10868
msgid ""
"The `x' forms work similarly to @code{@@itemx} (@pxref{@code{@@itemx}})."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10870
#, no-wrap
msgid "Def Cmds in Detail"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10872
msgid "@nodedescription Reference for all the definition commands."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:10872
#, no-wrap
msgid "The Definition Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10875
msgid "This section describes all the definition commands of Texinfo."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10877
#, no-wrap
msgid "Functions Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10879
msgid "@nodedescription Commands for functions and similar entities."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:10879
#, no-wrap
msgid "Functions and Similar Entities"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10881
#, no-wrap
msgid "Function definitions"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10882
#, no-wrap
msgid "Command definitions"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10883
#, no-wrap
msgid "Macro definitions, programming-language"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10887
msgid ""
"This section describes the commands for describing functions and similar "
"entities with simple arguments:"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10889
#, no-wrap
msgid "deffn"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10890
#: texinfo/texinfo-ed.7.1-en_US.texi:18768
#, no-wrap
msgid "@@deffn @var{category} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10900
msgid ""
"The @code{@@deffn} command is the general definition command for functions, "
"interactive commands, and similar entities that may take simple arguments.  "
"You must choose a term to describe the category of entity being defined; for "
"example, ``Function'' could be used if the entity is a function.  The "
"@code{@@deffn} command is written at the beginning of a line and is followed "
"on the same line by the category of entity being described, the name of this "
"particular entity, and its arguments, if any.  Terminate the definition with "
"@code{@@end deffn} on a line of its own."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10903
msgid "For example, here is a definition:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10909
#, no-wrap
msgid ""
"@@deffn Command forward-char nchars\n"
"Move point forward @@var@{nchars@} characters.\n"
"@@end deffn\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10915
msgid ""
"This shows a rather terse definition for a ``command'' named "
"@code{forward-char} with one argument, @var{nchars}."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10919
msgid ""
"Where the output format allows, @code{@@deffn} uses a typewriter font for "
"@var{name}, and a slanted font for the rest of the @var{arguments}, as would "
"be produced by @code{@@var}."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10923
msgid ""
"Within the text of the description, write an argument name explicitly with "
"@code{@@var} to refer to the value of the argument.  In the example above, "
"we used @samp{@@var@{nchars@}} in this way."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10930
msgid ""
"In the extremely unusual case when an argument name contains @samp{--}, or "
"another character sequence which is treated specially (@pxref{Conventions}), "
"use @code{@@code} around the special characters.  This avoids the conversion "
"to typographic en-dashes and em-dashes."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10931
#, no-wrap
msgid "defun"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10932
#, no-wrap
msgid "@@defun @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10937
msgid ""
"The @code{@@defun} command is the definition command for functions with "
"simple arguments.  @code{@@defun} is equivalent to @samp{@@deffn Function "
"@dots{}}.  Terminate the definition with @code{@@end defun} on a line of its "
"own."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10938
#, no-wrap
msgid "defmac"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10939
#, no-wrap
msgid "@@defmac @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10943
msgid ""
"The @code{@@defmac} command is the definition command for macros.  "
"@code{@@defmac} is equivalent to @samp{@@deffn Macro @dots{}} and works like "
"@code{@@defun}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10944
#, no-wrap
msgid "defspec"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10945
#, no-wrap
msgid "@@defspec @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10951
msgid ""
"The @code{@@defspec} command is the definition command for special forms.  "
"(In Lisp, a special form is an entity much like a function; @pxref{Special "
"Forms,,, elisp, GNU Emacs Lisp Reference Manual}.)  @code{@@defspec} is "
"equivalent to @samp{@@deffn @{Special Form@} @dots{}} and works like "
"@code{@@defun}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10954
msgid "All these commands create entries in the index of functions."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:10956
#, no-wrap
msgid "Typed Functions"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10958
msgid "@nodedescription Commands for functions in typed languages."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:10958
#, no-wrap
msgid "Functions in Typed Languages"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10960
#, no-wrap
msgid "Typed functions"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:10961
#, no-wrap
msgid "Functions, in typed languages"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:10966
msgid ""
"The @code{@@deftypefn} command and its variants are generic commands for "
"describing functions.  They are particularly suitable for languages in which "
"you must declare types of variables and functions, such as C and C++."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:10968
#, no-wrap
msgid "deftypefn"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:10969
#: texinfo/texinfo-ed.7.1-en_US.texi:18837
#, no-wrap
msgid ""
"@@deftypefn @var{category} @var{data-type} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:10976
msgid ""
"The @code{@@deftypefn} command is the general definition command for "
"functions and similar entities that may take arguments and that could be "
"typed.  The @code{@@deftypefn} command is written at the beginning of a line "
"and is followed on the same line by the category of entity being described, "
"information on the returned value, the name of this particular entity, and "
"its arguments, if any."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:10987
#, no-wrap
msgid ""
"@@deftypefn @{Library Function@} int foobar @@\n"
"  (int @@var@{foo@}, float @@var@{bar@})\n"
"@dots{}\n"
"@@end deftypefn\n"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:10993
#, no-wrap
msgid "{Library Function} int foobar  (int @var{foo}, float @var{bar})"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11002
msgid ""
"This means that @code{foobar} is a ``library function'' that returns an "
"@code{int}, and its arguments are @var{foo} (an @code{int}) and @var{bar} (a "
"@code{float}).  @samp{Library Function} has to be enclosed in braces to make "
"it a single argument."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11010
msgid ""
"When using @code{@@deftypefn} command and variations, you should mark "
"parameter names with @code{@@var} to distinguish these from data type names, "
"keywords, and other parts of the literal syntax of the programming "
"language.  Where the output format allows, all output on the definition line "
"is in a typewriter font by default.  @code{@@var} uses an appropriate font "
"where it occurs."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11014
msgid ""
"If you are describing a procedure in a language that has packages, such as "
"Ada, you might consider using @code{@@deftypefn} in the following manner:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11022
#, no-wrap
msgid ""
"@@deftypefn stacks private push @@\n"
"       (@@var@{s@}:in out stack; @@\n"
"       @@var@{n@}:in integer)\n"
"@dots{}\n"
"@@end deftypefn\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11029
msgid ""
"(In these examples the @code{@@deftypefn} arguments are shown using "
"continuations (@pxref{Def Cmd Continuation Lines}), but could be on a single "
"line.)"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11034
msgid ""
"In this instance, the procedure is classified as belonging to the package "
"@code{stacks} rather than classified as a `procedure' and its data type is "
"described as @code{private}.  (The name of the procedure is @code{push}, and "
"its arguments are @var{s} and @var{n}.)  Output:"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11035
#, no-wrap
msgid "stacks private push @"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11039
msgid "(@var{s}:in out stack; @ @var{n}:in integer)  @dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11046
msgid ""
"@code{@@deftypefn} and variants could be used when it is convenient to "
"interpret the arguments list as literal computer code, marking argument "
"names with @code{@@var}.  It is not necessary for any type names to appear, "
"and you can give an empty return type as @samp{@{@}}."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11060
#, no-wrap
msgid ""
"@@deftypefn stats @{@} t.test (@@var@{x@}, @@var@{y@} = NULL,@@\n"
"  @@w@{@@var@{alternative@} = c(\"two.sided\", \"less\", \"greater\")@},@@\n"
"  @@w@{@@var@{mu@} = 0@}, @@w@{@@var@{paired@} = FALSE@},@@\n"
"  @@w@{@@var@{var.equal@} = FALSE@},@@\n"
"  @@w@{@@var@{conf.level@} = 0.95@}, @@dots@{@})\n"
"@dots{}\n"
"@@end deftypefn\n"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11064
#, no-wrap
msgid "stats {} t.test (@var{x}, @var{y} = NULL,@"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11070
#, no-wrap
msgid ""
"  @w{@var{alternative} = c(\"two.sided\", \"less\", \"greater\")},@\n"
"  @w{@var{mu} = 0}, @w{@var{paired} = FALSE},@\n"
"  @w{@var{var.equal} = FALSE},@\n"
"  @w{@var{conf.level} = 0.95}, @dots{})\n"
"@dots{}\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11079
msgid ""
"The information on return values may be used to name the return variables. "
"For example, in Perl, returned scalars may be given the @var{$result} and "
"@var{$status} name in the following manner:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11085
#, no-wrap
msgid ""
"@@deftypefn @{Sub@} @{(@@var@{$result@}, @@var@{$status@} =)@} @@\n"
"                     process (@@var@{$input@})\n"
"@dots{} Set @@var@{$status@} to 0 in case of failure @dots{}\n"
"@@end deftypefn\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11088
msgid "to get output like"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11089
#, no-wrap
msgid "{Sub} {(@var{$result}, @var{$status}) =} process (@var{$input})"
msgstr ""

#. type: deftypefn
#: texinfo/texinfo-ed.7.1-en_US.texi:11091
msgid "@dots{} Set @var{$status} to 0 in case of failure @dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11095
msgid ""
"@code{@@deftypefn} creates an entry in the index of functions for @var{name}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11096
#, no-wrap
msgid "deftypefun"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11097
#, no-wrap
msgid "@@deftypefun @var{data-type} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11101
msgid ""
"The @code{@@deftypefun} command is the specialized definition command for "
"functions.  The command is equivalent to @samp{@@deftypefn Function @dots{}}."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11104
msgid ""
"@code{@@deftypefun} creates an entry in the index of functions for "
"@var{name}."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11107
#, no-wrap
msgid "Return type, own line for"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11108
#, no-wrap
msgid "deftypefnnewline"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11113
msgid ""
"Ordinarily, the return type is printed on the same line as the function name "
"and arguments, as shown above.  In source code, GNU style for typed "
"functions is to put the return type on a line by itself.  So Texinfo "
"provides an option to do that: @code{@@deftypefnnewline on}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11120
msgid ""
"This affects the generic functions only---not untyped functions with simple "
"arguments such as @code{@@deffn}, not typed variables, etc.  Specifically, "
"it affects the commands in this section, and the analogous commands for "
"object-oriented languages, namely @code{@@deftypeop} and "
"@code{@@deftypemethod} (@pxref{Object-Oriented Methods})."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11122
msgid "Specifying @code{@@deftypefnnewline off} reverts to the default."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11124
#, no-wrap
msgid "Variables Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11126
msgid "@nodedescription Commands for variables and similar entities."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11126
#, no-wrap
msgid "Variables and Similar Entities"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11130
msgid "Here are the commands for defining variables and similar entities:"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11132
#, no-wrap
msgid "defvr"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11133
#: texinfo/texinfo-ed.7.1-en_US.texi:18898
#, no-wrap
msgid "@@defvr @var{category} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11141
msgid ""
"The @code{@@defvr} command is a general definition command for something "
"like a variable---an entity that records a value.  You must choose a term to "
"describe the category of entity being defined; for example, ``Variable'' "
"could be used if the entity is a variable.  Write the @code{@@defvr} command "
"at the beginning of a line and follow it on the same line by the category of "
"the entity and the name of the entity."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11146
msgid ""
"We recommend capitalizing the category name like a title.  If the name of "
"the category contains spaces, as in the name ``User Option'', enclose it in "
"braces.  Otherwise, the second word will be mistaken for the name of the "
"entity.  For example,"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11154
#, no-wrap
msgid ""
"@@defvr @{User Option@} fill-column\n"
"This buffer-local variable specifies\n"
"the maximum width of filled lines.\n"
"@dots{}\n"
"@@end defvr\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11159
msgid "Terminate the definition with @code{@@end defvr} on a line of its own."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11161
msgid ""
"@code{@@defvr} creates an entry in the index of variables for @var{name}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11162
#, no-wrap
msgid "defvar"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11163
#, no-wrap
msgid "@@defvar @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11167
msgid ""
"The @code{@@defvar} command is the definition command for variables.  "
"@code{@@defvar} is equivalent to @samp{@@defvr Variable @dots{}}."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11176
#, no-wrap
msgid ""
"@@defvar kill-ring\n"
"@dots{}\n"
"@@end defvar\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11181
msgid ""
"@code{@@defvar} creates an entry in the index of variables for @var{name}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11182
#, no-wrap
msgid "defopt"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11183
#, no-wrap
msgid "User options, marking"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11184
#, no-wrap
msgid "@@defopt @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11190
msgid ""
"The @code{@@defopt} command is the definition command for @dfn{user "
"options}, i.e., variables intended for users to change according to taste; "
"Emacs has many such (@pxref{Variables,,, emacs, The GNU Emacs Manual}).  "
"@code{@@defopt} is equivalent to @samp{@@defvr @{User Option@} @dots{}}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11193
#, no-wrap
msgid "Typed Variables"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11195
msgid "@nodedescription Commands for variables in typed languages."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11195
#, no-wrap
msgid "Variables in Typed Languages"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11197
#, no-wrap
msgid "Typed variables"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11198
#, no-wrap
msgid "Variables, in typed languages"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11205
msgid ""
"Variables in typed languages are handled in a manner similar to functions in "
"typed languages.  @xref{Typed Functions}.  The general definition command "
"@code{@@deftypevr} corresponds to @code{@@deftypefn} and the specialized "
"definition command @code{@@deftypevar} corresponds to @code{@@deftypefun}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11207
#, no-wrap
msgid "deftypevr"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11208
#: texinfo/texinfo-ed.7.1-en_US.texi:18881
#, no-wrap
msgid "@@deftypevr @var{category} @var{data-type} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11214
msgid ""
"The @code{@@deftypevr} command is the general definition command for "
"something like a variable in a typed language---an entity that records a "
"value.  You must choose a term to describe the category of the entity being "
"defined; for example, ``Variable'' could be used if the entity is a variable."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11219
msgid ""
"The @code{@@deftypevr} command is written at the beginning of a line and is "
"followed on the same line by the category of the entity being described, the "
"data type, and the name of this particular entity."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11229
#, no-wrap
msgid ""
"@@deftypevr @{Global Flag@} int enable\n"
"@dots{}\n"
"@@end deftypevr\n"
msgstr ""

#. type: deftypevr
#: texinfo/texinfo-ed.7.1-en_US.texi:11236
#, no-wrap
msgid "{Global Flag} int enable"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11241
#, no-wrap
msgid "deftypevar"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11242
#, no-wrap
msgid "@@deftypevar @var{data-type} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11246
msgid ""
"The @code{@@deftypevar} command is the specialized definition command for "
"variables in typed languages.  @code{@@deftypevar} is equivalent to "
"@samp{@@deftypevr Variable @dots{}}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11249
msgid "These commands create entries in the index of variables."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11251
#: texinfo/texinfo-ed.7.1-en_US.texi:11253
#, no-wrap
msgid "Data Types"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11253
msgid "@nodedescription The definition command for data types."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11256
msgid "Here is the command for data types:"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11258
#, no-wrap
msgid "deftp"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11259
#, no-wrap
msgid "@@deftp @var{category} @var{name} @var{attributes}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11269
msgid ""
"The @code{@@deftp} command is the generic definition command for data "
"types.  The command is written at the beginning of a line and is followed on "
"the same line by the category, by the name of the type (which is a word like "
"@code{int} or @code{float}), and then by names of attributes of objects of "
"that type.  Thus, you could use this command for describing @code{int} or "
"@code{float}, in which case you could use @code{data type} as the category.  "
"(A data type is a category of certain objects for purposes of deciding which "
"operations can be performed on them.)"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11274
msgid ""
"In Lisp, for example, @dfn{pair} names a particular data type, and an object "
"of that type has two slots called the @sc{car} and the @sc{cdr}.  Here is "
"how you would write the first line of a definition of @code{pair}."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11280
#, no-wrap
msgid ""
"@@deftp @{Data type@} pair car cdr\n"
"@dots{}\n"
"@@end deftp\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11284
msgid "@code{@@deftp} creates an entry in the index of data types."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11287
#, no-wrap
msgid "Abstract Objects"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11289
msgid "@nodedescription Commands for object-oriented programming."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11289
#, no-wrap
msgid "Object-Oriented Programming"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11291
#, no-wrap
msgid "Object-oriented programming"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11299
msgid ""
"Here are the commands for formatting descriptions about abstract objects, "
"such as are used in object-oriented programming.  A class is a defined type "
"of abstract object.  An instance of a class is a particular object that has "
"the type of the class.  An instance variable is a variable that belongs to "
"the class but for which each instance has its own value."
msgstr ""

#. type: menuentry
#: texinfo/texinfo-ed.7.1-en_US.texi:11303
msgid "Variables: Object-Oriented Variables."
msgstr ""

#. type: menuentry
#: texinfo/texinfo-ed.7.1-en_US.texi:11303
msgid "Methods: Object-Oriented Methods"
msgstr ""

#. type: subsubsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11306
#: texinfo/texinfo-ed.7.1-en_US.texi:11307
#, no-wrap
msgid "Object-Oriented Variables"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11309
#, no-wrap
msgid "Variables, object-oriented"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11313
msgid ""
"These commands allow you to define different sorts of variables in "
"object-oriented programming languages."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11315
#, no-wrap
msgid "defcv"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11316
#: texinfo/texinfo-ed.7.1-en_US.texi:18761
#, no-wrap
msgid "@@defcv @var{category} @var{class} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11322
msgid ""
"The @code{@@defcv} command is the general definition command for variables "
"associated with classes in object-oriented programming.  The @code{@@defcv} "
"command is followed by three arguments: the category of thing being defined, "
"the class to which it belongs, and its name.  For instance:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11328
#, no-wrap
msgid ""
"@@defcv @{Class Option@} Window border-pattern\n"
"@dots{}\n"
"@@end defcv\n"
msgstr ""

#. type: defcv
#: texinfo/texinfo-ed.7.1-en_US.texi:11332
#, no-wrap
msgid "{Class Option} Window border-pattern"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11337
msgid "@code{@@defcv} creates an entry in the index of variables."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11338
#, no-wrap
msgid "deftypecv"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11339
#: texinfo/texinfo-ed.7.1-en_US.texi:18832
#, no-wrap
msgid "@@deftypecv @var{category} @var{class} @var{data-type} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11344
msgid ""
"The @code{@@deftypecv} command is the definition command for typed class "
"variables in object-oriented programming.  It is analogous to @code{@@defcv} "
"with the addition of the @var{data-type} parameter to specify the type of "
"the instance variable."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11350
#, no-wrap
msgid ""
"@@deftypecv @{Class Option@} Window int border-pattern\n"
"@dots{}\n"
"@@end deftypecv\n"
msgstr ""

#. type: deftypecv
#: texinfo/texinfo-ed.7.1-en_US.texi:11355
#, no-wrap
msgid "{Class Option} Window int border-pattern"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11360
msgid "@code{@@deftypecv} creates an entry in the index of variables."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11361
#, no-wrap
msgid "defivar"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11362
#, no-wrap
msgid "@@defivar @var{class} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11367
msgid ""
"The @code{@@defivar} command is the definition command for instance "
"variables in object-oriented programming.  @code{@@defivar} is equivalent to "
"@samp{@@defcv @{Instance Variable@} @dots{}}.  For instance:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11373
#, no-wrap
msgid ""
"@@defivar Window border-pattern\n"
"@dots{}\n"
"@@end defivar\n"
msgstr ""

#. type: defivar
#: texinfo/texinfo-ed.7.1-en_US.texi:11378
#, no-wrap
msgid "Window border-pattern"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11383
msgid "@code{@@defivar} creates an entry in the index of variables."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11384
#, no-wrap
msgid "deftypeivar"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11385
#, no-wrap
msgid "@@deftypeivar @var{class} @var{data-type} @var{name}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11390
msgid ""
"The @code{@@deftypeivar} command is the definition command for typed "
"instance variables in object-oriented programming.  It is analogous to "
"@code{@@defivar} with the addition of the @var{data-type} parameter to "
"specify the type of the instance variable."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11396
#, no-wrap
msgid ""
"@@deftypeivar Window int border-pattern\n"
"@dots{}\n"
"@@end deftypeivar\n"
msgstr ""

#. type: deftypeivar
#: texinfo/texinfo-ed.7.1-en_US.texi:11401
#, no-wrap
msgid "Window @code{int} border-pattern"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11406
msgid "@code{@@deftypeivar} creates an entry in the index of variables."
msgstr ""

#. type: subsubsection
#: texinfo/texinfo-ed.7.1-en_US.texi:11410
#: texinfo/texinfo-ed.7.1-en_US.texi:11411
#, no-wrap
msgid "Object-Oriented Methods"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11413
#, no-wrap
msgid "Methods, object-oriented"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11419
msgid ""
"These commands allow you to define different sorts of function-like entities "
"resembling methods in object-oriented programming languages.  These entities "
"take arguments, as functions do, but are associated with particular classes "
"of objects."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11422
#, no-wrap
msgid "defop"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11423
#: texinfo/texinfo-ed.7.1-en_US.texi:18807
#, no-wrap
msgid "@@defop @var{category} @var{class} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11426
msgid ""
"The @code{@@defop} command is the definition command for these method-like "
"entities with simple arguments."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11431
msgid ""
"For example, some systems have constructs called @dfn{wrappers} that are "
"associated with classes as methods are, but that act more like macros than "
"like functions.  You could use @code{@@defop Wrapper} to describe one of "
"these."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11441
msgid ""
"Sometimes it is useful to distinguish methods and @dfn{operations}.  You can "
"think of an operation as the specification for a method.  Thus, a window "
"system might specify that all window classes have a method named "
"@code{expose}; we would say that this window system defines an @code{expose} "
"operation on windows in general.  Typically, the operation has a name and "
"also specifies the pattern of arguments; all methods that implement the "
"operation must accept the same arguments, since applications that use the "
"operation do so without knowing which method will implement it."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11447
msgid ""
"Often it makes more sense to document operations than methods.  For example, "
"window application developers need to know about the @code{expose} "
"operation, but need not be concerned with whether a given class of windows "
"has its own method to implement this operation.  To describe this operation, "
"you would write:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11450
#, no-wrap
msgid "@@defop Operation windows expose\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11456
msgid ""
"The @code{@@defop} command is written at the beginning of a line and is "
"followed on the same line by the overall name of the category of operation, "
"the name of the class of the operation, the name of the operation, and its "
"arguments, if any."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11459
msgid ""
"@code{@@defop} creates an entry, such as `@code{expose} on @code{windows}', "
"in the index of functions."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11460
#, no-wrap
msgid "deftypeop"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11461
#: texinfo/texinfo-ed.7.1-en_US.texi:18870
#, no-wrap
msgid ""
"@@deftypeop @var{category} @var{class} @var{data-type} @var{name} "
"@var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11468
msgid ""
"The @code{@@deftypeop} command is the generic definition command for "
"operations in object-oriented programming.  It is particularly suitable for "
"typed object-oriented languages. It is similar to @code{@@defop} with the "
"addition of the @var{data-type} parameter to specify information on the "
"return value of the method, for example the return type."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11469
#, no-wrap
msgid "defmethod"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11470
#, no-wrap
msgid "@@defmethod @var{class} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11475
msgid ""
"The @code{@@defmethod} command is the definition command for methods in "
"object-oriented programming.  A method is a kind of function that implements "
"an operation for a particular class of objects and its subclasses."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11486
msgid ""
"@code{@@defmethod} is equivalent to @samp{@@defop Method @dots{}}.  The "
"command is written at the beginning of a line and is followed by the name of "
"the class of the method, the name of the method, and its arguments, if any."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11494
#, no-wrap
msgid ""
"@@defmethod @code{bar-class} bar-method argument\n"
"@dots{}\n"
"@@end defmethod\n"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11500
msgid ""
"illustrates the definition for a method called @code{bar-method} of the "
"class @code{bar-class}.  The method takes an argument."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11502
msgid "@code{@@defmethod} creates an entry in the index of functions."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11503
#, no-wrap
msgid "deftypemethod"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11504
#, no-wrap
msgid ""
"@@deftypemethod @var{class} @var{data-type} @var{name} @var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11510
msgid ""
"The @code{@@deftypemethod} command is the definition command for methods in "
"object-oriented languages, in particular for typed languages such as C++ and "
"Java.  It is similar to the @code{@@defmethod} command with the addition of "
"the @var{data-type} parameter to specify information on the return value of "
"the method, for example the return type."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11516
msgid ""
"The commands with information on return values are affected by the "
"@code{@@deftypefnnewline} option (@pxref{Typed Functions,, Functions in "
"Typed Languages})."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:11518
#: texinfo/texinfo-ed.7.1-en_US.texi:11520
#, no-wrap
msgid "Generic Definition Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11520
msgid "@nodedescription Without automatic index entries."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11524
msgid ""
"Texinfo provides commands for definitions that do not produce automatic "
"index entries."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11525
#, no-wrap
msgid "defblock"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11526
#, no-wrap
msgid "defline"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11527
#, no-wrap
msgid "deftypeline"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11532
msgid ""
"You create a generic definition environment with @samp{@@defblock} paired "
"with @samp{@@end defblock}.  Within this environment, use a @code{@@defline} "
"or @code{@@deftypeline} line for each symbol you document.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11540
#, no-wrap
msgid ""
"@@defblock\n"
"@@defline Macro mac (arg1, arg2)\n"
"Description of mac.\n"
"@@deftypeline Builtin int foo (int @@var@{bar@})\n"
"Description of foo.\n"
"@@end defblock\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11549
msgid ""
"@defblock @defline Macro mac (arg1, arg2)  Description of mac.  @deftypeline "
"Builtin int foo (int @var{bar})  Description of foo."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11555
msgid ""
"The syntax of @code{@@defline} is similar to that of @code{@@deffn}.  The "
"first argument gives a category for the definition.  Follow this with the "
"symbol name, followed by any parameters.  You should surround any arguments "
"containing spaces with braces."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11559
msgid ""
"You use @code{@@deftypeline} in a similar way to @code{@@deftypefn}, "
"following the category with a data type, and marking any parameters with "
"@code{@@var}. (@xref{Typed Functions}).)"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11562
msgid ""
"To share the same description for multiple symbols, you can put several "
"@code{@@defline} lines together.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11569
#, no-wrap
msgid ""
"@@defblock\n"
"@@defline Function set-var (value)\n"
"@@defline @{Settable Variable@} var\n"
"Description of set-var and var.\n"
"@@end defblock\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11577
msgid ""
"@defblock @defline Function set-var (value)  @defline {Settable Variable} "
"var Description of set-var and var."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11581
msgid ""
"It may be useful to define line macros (@pxref{Line Macros}) in combination "
"with these commands."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11584
#, no-wrap
msgid "Def Cmd Conventions"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11586
msgid "@nodedescription Conventions for writing definitions."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:11586
#, no-wrap
msgid "Conventions for Writing Definitions"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11587
#, no-wrap
msgid "Definition conventions"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11588
#, no-wrap
msgid "Conventions for writing definitions"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11593
msgid ""
"A manual need not and should not contain more than one definition for a "
"given name.  An appendix containing a summary should use @code{@@table} "
"rather than the definition commands."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11600
msgid ""
"When you write a definition using @code{@@deffn}, @code{@@defun}, or one of "
"the other definition commands, please take care to use arguments that "
"indicate the meaning, as with the @var{count} argument to the "
"@code{forward-word} function.  Also, if the name of an argument contains the "
"name of a type, such as @var{integer}, take care that the argument actually "
"is of that type."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11607
msgid ""
"@emph{Fonts.} As Texinfo is a semantic language, you should nearly never "
"need to specify font styles with explicit font commands in definitions "
"(@pxref{Fonts}).  However, you may be need to work around problems for "
"particular output formats and/or constructs.  Here are some possibilities:"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:11612
msgid ""
"Explicitly marking a Lisp keyword like @samp{&@var{keyword}} with "
"@code{@@r@{&keyword@}}, producing @r{&keyword}."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:11616
msgid ""
"Note such keywords in definition arguments are (at present)  rendered in "
"roman in @TeX{}, but this formatting is not done in any other output format."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:11621
msgid ""
"@samp{@@r@{@@slanted@{argument@}@}}, producing @r{@slanted{argument}}, "
"similar to @code{@@var} but avoiding upper-casing its argument in Info "
"output."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:11625
msgid ""
"In this and the previous point, @code{@@r} resets the font from that being "
"used in the definition line context (slanted or typewriter) to a roman, "
"upright style."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:11633
msgid ""
"You could use @code{@@t} (or even @samp{@@r@{@@t@{@dots{}}, using @code{@@r} "
"to reset font styles) to mark literal syntax on a definition line where text "
"would otherwise be output in the slanted roman style.  @code{@@code} would "
"be inappropriate here as it adds quotation marks in Info output."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11638
msgid ""
"Some degree of trial and error may be needed to get the result you want.  As "
"ever, how nested font commands combine depends on the output format, so "
"should be avoided where possible."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11642
msgid ""
"Hopefully, such usages are kept to a minimum.  One possibility is to wrap "
"these in @code{@@macro} (@pxref{Defining New Texinfo Commands}), allowing "
"these usages to be easily changed in the future."
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11653
#, no-wrap
msgid ""
"@@macro metasymbol @{argument@}\n"
"@@r@{@@t@{@@slanted@{\\argument\\@}@}@}\n"
"@@end macro\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11657
#, no-wrap
msgid ""
"@@macro strongkeyword @{argument@}\n"
"@@r@{@@strong@{\\argument\\@}@}\n"
"@@end macro\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11661
#, no-wrap
msgid ""
"@@defun fset arg @@metasymbol@{[ +@} @@strongkeyword@{*keyword@}\n"
"@dots{}\n"
"@@end defun\n"
msgstr ""

#. type: macro
#: texinfo/texinfo-ed.7.1-en_US.texi:11668
#, no-wrap
msgid "@r{@t{@slanted{\\argument\\}}}\n"
msgstr ""

#. type: macro
#: texinfo/texinfo-ed.7.1-en_US.texi:11672
#, no-wrap
msgid "@r{@strong{\\argument\\}}\n"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11674
#, no-wrap
msgid "fset arg @metasymbol{[ +} @strongkeyword{*keyword}"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11676
#, no-wrap
msgid "@dots{}\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11680
#, no-wrap
msgid "Sample Function Definition"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11682
msgid "@nodedescription An example."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:11682
#, no-wrap
msgid "A Sample Function Definition"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11683
#, no-wrap
msgid "Sample function definition"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11689
msgid ""
"Here is a definition from @ref{Calling Functions,,, elisp, The GNU Emacs "
"Lisp Reference Manual}, using the @code{@@defun} command.  The name of the "
"function, @code{apply}, follows immediately after the @code{@@defun} command "
"and it is followed, on the same line, by the parameter list."
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11691
#, no-wrap
msgid "apply function @r{&rest} arguments"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11697
msgid ""
"@code{apply} calls @var{function} with @var{arguments}, just like "
"@code{funcall} but with one difference: the last of @var{arguments} is a "
"list of arguments to give to @var{function}, rather than a single argument.  "
"We also say that this list is @dfn{appended} to the other arguments."
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11702
msgid ""
"@code{apply} returns the result of calling @var{function}.  As with "
"@code{funcall}, @var{function} must either be a Lisp function or a primitive "
"function; special forms and macros do not make sense in @code{apply}."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11712
#, no-wrap
msgid ""
"(setq f 'list)\n"
"    @result{} list\n"
"(apply f 'x 'y 'z)\n"
"@error{} Wrong type argument: listp, z\n"
"(apply '+ 1 2 '(3 4))\n"
"    @result{} 10\n"
"(apply '+ '(1 2 3 4))\n"
"    @result{} 10\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11715
#, no-wrap
msgid ""
"(apply 'append '((a b c) nil (x y z) nil))\n"
"    @result{} (a b c x y z)\n"
msgstr ""

#. type: defun
#: texinfo/texinfo-ed.7.1-en_US.texi:11719
msgid ""
"An interesting example of using @code{apply} is found in the description of "
"@code{mapcar}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11723
msgid "In the Texinfo source file, this example should look like this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11733
#, no-wrap
msgid ""
"@@defun apply function @@r@{&rest@} arguments\n"
"@@code@{apply@} calls @@var@{function@} with\n"
"@@var@{arguments@}, just like @@code@{funcall@} but with one\n"
"difference: the last of @@var@{arguments@} is a list of\n"
"arguments to give to @@var@{function@}, rather than a single\n"
"argument.  We also say that this list is @@dfn@{appended@}\n"
"to the other arguments.\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11741
#, no-wrap
msgid ""
"@@code@{apply@} returns the result of calling\n"
"@@var@{function@}.  As with @@code@{funcall@},\n"
"@@var@{function@} must either be a Lisp function or a\n"
"primitive function; special forms and macros do not make\n"
"sense in @@code@{apply@}.\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11753
#, no-wrap
msgid ""
"@@example\n"
"(setq f 'list)\n"
"    @@result@{@} list\n"
"(apply f 'x 'y 'z)\n"
"@@error@{@} Wrong type argument: listp, z\n"
"(apply '+ 1 2 '(3 4))\n"
"    @@result@{@} 10\n"
"(apply '+ '(1 2 3 4))\n"
"    @@result@{@} 10\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11757
#, no-wrap
msgid ""
"(apply 'append '((a b c) nil (x y z) nil))\n"
"    @@result@{@} (a b c x y z)\n"
"@@end example\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:11763
#, no-wrap
msgid ""
"An interesting example of using @@code@{apply@} is found\n"
"in the description of @@code@{mapcar@}.\n"
"@@end defun\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11769
msgid ""
"In this manual, this function is listed in the Command and Variable Index "
"under @code{apply}."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11771
#: texinfo/texinfo-ed.7.1-en_US.texi:11773
#: texinfo/texinfo-ed.7.1-en_US.texi:11775
#, no-wrap
msgid "Internationalization"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11773
msgid "@nodedescription Supporting languages other than English."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11780
msgid ""
"Texinfo has some support for writing in languages other than English, "
"although this area still needs considerable work.  (If you are the one "
"helping to translate the fixed strings written to documents, "
"@pxref{Internationalization of Document Strings}.)"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11783
msgid ""
"For a list of the various accented and special characters Texinfo supports, "
"see @ref{Inserting Accents}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11785
#, no-wrap
msgid "@code{@@documentlanguage}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11787
msgid "@nodedescription Declaring the current language."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:11787
#, no-wrap
msgid ""
"@code{@@documentlanguage @var{ll}[_@var{cc}]}: Set the Document Language"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11789
#: texinfo/texinfo-ed.7.1-en_US.texi:11790
#, no-wrap
msgid "documentlanguage"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11791
#, no-wrap
msgid "Language, declaring"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11792
#, no-wrap
msgid "Locale, declaring"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11793
#, no-wrap
msgid "Document language, declaring"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11797
msgid ""
"The @code{@@documentlanguage} command declares the current document locale.  "
"Write it on a line by itself, near the beginning of the file."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11800
#, no-wrap
msgid "@@documentlanguage @var{ll}[_@var{cc}]\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11808
msgid ""
"Include a two-letter ISO@tie{}639-2 language code (@var{ll}) following the "
"command name, optionally followed by an underscore and two-letter "
"ISO@tie{}3166 two-letter country code (@var{cc}).  If you have a "
"multilingual document, the intent is to be able to use this command multiple "
"times, to declare each language change.  If the command is not used at all, "
"the default is @code{en_US} for US English."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11813
msgid ""
"As with GNU Gettext (@pxref{Top,,, gettext, Gettext}), if the country code "
"is omitted, the main dialect is assumed where possible.  For example, "
"@code{de} is equivalent to @code{de_DE} (German as spoken in Germany)."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11814
#, no-wrap
msgid "Document strings, translation of"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11823
msgid ""
"For Info and other online output, this command changes the translation of "
"various @dfn{document strings} such as ``see'' in cross-references "
"(@pxref{Cross References}), ``Function'' in defuns (@pxref{Definition "
"Commands}), and so on.  Some strings, such as ``Node:'', ``Next:'', "
"``Menu:'', etc., are keywords in Info output, so are not translated there; "
"they are translated in other output formats.  In DocBook output "
"@code{@@documentlanguage} sets the language for following sections."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11826
msgid ""
"For @LaTeX{}, this command causes code to load the @samp{babel} package to "
"be output in the preamble, and @code{\\selectlanguage} to be output."
msgstr ""

#. type: file{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:11827
#, no-wrap
msgid "txi-@var{cc}.tex"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11833
msgid ""
"For @TeX{}, this command causes a file @file{txi-@var{locale}.tex} to be "
"read (if it exists).  If @code{@@documentlanguage} argument contains the "
"optional @samp{_@var{cc}} suffix, this is tried first.  For example, with "
"@code{@@documentlanguage de_DE}, @TeX{} first looks for "
"@file{txi-de_DE.tex}, then @file{txi-de.tex}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11840
msgid ""
"Such a @file{txi-*} file is intended to redefine the various English words "
"used in @TeX{} output, such as `Chapter', `See', and so on.  We are aware "
"that individual words like these cannot always be translated in isolation, "
"and that a very different strategy would be required for ideographic (among "
"other) scripts.  Help in improving Texinfo's language support is welcome."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11841
#, no-wrap
msgid "Hyphenation patterns, language-dependent"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11850
msgid ""
"@code{@@documentlanguage} also changes @TeX{}'s current hyphenation "
"patterns, if the @TeX{} program being run has the necessary support "
"included.  This will generally not be the case for @command{tex} itself, but "
"will usually be the case for up-to-date distributions of the extended @TeX{} "
"programs @command{etex} (DVI output) and @command{pdftex} (PDF output).  "
"@command{texi2dvi} will use the extended @TeX{}s if they are available "
"(@pxref{Format with @command{texi2dvi}})."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11851
#, no-wrap
msgid "ISO 639-2 language codes"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11852
#, no-wrap
msgid "ISO 3166 country codes"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11853
#, no-wrap
msgid "Language codes"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11854
#, no-wrap
msgid "Country codes"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11861
msgid ""
"Since the lists of language codes and country codes are updated relatively "
"frequently, we don't attempt to list them here.  The valid language codes "
"are on the official home page for ISO@tie{}639, "
"@url{http://www.loc.gov/standards/iso639-2/}.  The country codes and the "
"official web site for ISO@tie{}3166 can be found via "
"@url{https://en.wikipedia.org/wiki/ISO_3166}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:11863
#, no-wrap
msgid "@code{@@documentencoding}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11865
msgid "@nodedescription Declaring the input encoding."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:11865
#, no-wrap
msgid "@code{@@documentencoding @var{enc}}: Set Input Encoding"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:11868
#, no-wrap
msgid "documentencoding"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11869
#, no-wrap
msgid "Encoding, declaring"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11870
#, no-wrap
msgid "Input encoding, declaring"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11871
#, no-wrap
msgid "Character set, declaring"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11872
#, no-wrap
msgid "Document input encoding"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11878
msgid ""
"In the default case, the input and output document encoding are assumed to "
"be UTF-8, the vast global character encoding, expressed in 8-bit bytes.  "
"UTF-8 is compatible with 7-bit ASCII.  It is recommended to use UTF-8 "
"encoding for Texinfo manuals."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11883
msgid ""
"The @code{@@documentencoding} command declares the input document encoding, "
"and also affects the encoding of the output.  Write it on a line by itself, "
"with a valid encoding specification following, near the beginning of the "
"file if your document encoding is not the default encoding."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11886
#, no-wrap
msgid "@@documentencoding @var{enc}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11895
msgid ""
"UTF-8 should always be the best choice for the encoding.  Texinfo still "
"supports additional encodings, mainly for compatibility with older "
"manuals@footnote{@command{texi2any} supports more encodings for Texinfo "
"manuals, potentially all the encodings supported by both Perl and iconv "
"(@pxref{Generic Charset Conversion,,, libc, The GNU C Library}).  The "
"support in output formats may be lacking, however, especially for @LaTeX{} "
"output.}:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11897
#, no-wrap
msgid "US-ASCII"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11899
msgid "Character encoding based on the English alphabet."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11900
#, no-wrap
msgid "Euro symbol, and encodings"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11901
#, no-wrap
msgid "ISO-8859-1"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:11902
#, no-wrap
msgid "ISO-8859-15"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:11903
#, no-wrap
msgid "ISO-8859-2"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11909
msgid ""
"These specify the pre-UTF-8 standard encodings for Western European (the "
"first two) and Eastern European languages (the third), respectively.  ISO "
"8859-15 replaces some little-used characters from 8859-1 (e.g., precomposed "
"fractions) with more commonly needed ones, such as the Euro symbol (@euro{})."
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11912
msgid ""
"A full description of the encodings is beyond our scope here; one useful "
"reference is @uref{http://czyborra.com/charsets/iso8859.html}."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11913
#, no-wrap
msgid "koi8-r"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11915
msgid ""
"This was a commonly used encoding for the Russian language before UTF-8."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:11916
#, no-wrap
msgid "koi8-u"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:11918
msgid ""
"This was a commonly used encoding for the Ukrainian language before UTF-8."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11921
#, no-wrap
msgid "Local Variables section, for encoding"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11922
#, no-wrap
msgid "Info output, and encoding"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11927
msgid ""
"In Info output, a so-called `Local Variables' section (@pxref{File "
"Variables,,, emacs, The GNU Emacs Manual}) is output including the output "
"encoding.  This allows Info readers to set the encoding appropriately.  It "
"looks like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11932
#, no-wrap
msgid ""
"Local Variables:\n"
"coding: UTF-8\n"
"End:\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11940
msgid ""
"By default, for Info and plain text output, @command{texi2any} outputs "
"accent constructs and special characters (such as @code{@@'e})  as the "
"actual UTF-8 sequence or 8-bit character in the output encoding where "
"possible.  If this is not possible, or if the option "
"@option{--disable-encoding} is given, an ASCII transliteration is used "
"instead."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11941
#, no-wrap
msgid "HTML output, and encodings"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11942
#, no-wrap
msgid "@code{http-equiv}, and charset specification"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11943
#, no-wrap
msgid "@code{<meta>} HTML tag, and charset specification"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11949
msgid ""
"In HTML output, a @samp{<meta>} tag is output, in the @samp{<head>} section "
"of the HTML, that specifies the output encoding.  Web servers and browsers "
"cooperate to use this information so the correct encoding is used to display "
"the page, if supported by the system.  That looks like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11953
#, no-wrap
msgid ""
"<meta http-equiv=\"Content-Type\" content=\"text/html;\n"
"     charset=utf-8\">\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11961
msgid ""
"In HTML and @LaTeX{} output, if @code{OUTPUT_CHARACTERS} is set "
"(@pxref{Other Customization Variables}), accent constructs and special "
"characters, such as @code{@@'e} or @code{``}, are output as the actual UTF-8 "
"sequence or 8-bit character in the output encoding where possible.  "
"Otherwise, HTML entities are used for those characters in HTML, and @LaTeX{} "
"macros are used in @LaTeX{}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11968
msgid ""
"In DocBook output, if the encoding is different from UTF-8, an "
"@code{encoding} attribute is added to the XML declaration.  If "
"@code{OUTPUT_CHARACTERS} is set (@pxref{Other Customization Variables}), "
"accent constructs such as @code{@@'e} are output as the actual 8-bit or "
"UTF-8 character in the output encoding where possible.  Otherwise XML "
"entities are used for those constructs."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:11969
#, no-wrap
msgid "Computer Modern fonts"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11975
msgid ""
"In @TeX{} output, the characters which are supported in the standard "
"Computer Modern fonts are output accordingly.  For example, this means using "
"constructed accents rather than precomposed glyphs.  Using a missing "
"character generates a warning message, as does specifying an unimplemented "
"encoding."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11980
msgid ""
"Although modern @TeX{} systems support nearly every script in use in the "
"world, this wide-ranging support is not available in @file{texinfo.tex}, and "
"it's not feasible to duplicate or incorporate all that effort."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11988
msgid ""
"In @LaTeX{} output, code loading the @samp{inputenc} package is output based "
"on the encoding.  This, by itself, does not ensures that all the characters "
"from the input document can be subsequently output.  The fonts used in the "
"default case should cover the specific Texinfo glyphs, but not all the "
"possible encoded characters.  You may need to load different fonts in the "
"preamble and use @code{\\DeclareUnicodeCharacter} with a UTF-8 encoding.  "
"For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:11992
#, no-wrap
msgid ""
"@@latex\n"
"\\DeclareUnicodeCharacter@{017B@}@{\\.Z@}\n"
"@@end latex\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:11998
msgid ""
"Cross-references between Info files in different character encodings with "
"non-ASCII characters in node names fail.  We strongly recommend using UTF-8 "
"only as the encoding for manuals with non-ASCII characters in the "
"destinations of cross-references."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12000
#, no-wrap
msgid "Conditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12002
msgid "@nodedescription Specifying text for only some output cases."
msgstr ""

#. type: chapter
#: texinfo/texinfo-ed.7.1-en_US.texi:12002
#, no-wrap
msgid "Conditionally Visible Text"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12003
#, no-wrap
msgid "Conditionally visible text"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12004
#, no-wrap
msgid "Text, conditionally visible"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12005
#, no-wrap
msgid "Visibility of conditional text"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12006
#, no-wrap
msgid "If text conditionally visible"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12012
msgid ""
"The @dfn{conditional commands} allow you to use different text for different "
"output formats, or for general conditions that you define.  For example, you "
"can use them to specify different text for the printed manual and the Info "
"output."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12014
msgid "The conditional commands comprise the following categories."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12018
msgid "Commands specific to an output format (Info, @TeX{}, HTML, @dots{})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12022
msgid ""
"Commands specific to any output format @emph{excluding} a given one (e.g., "
"not Info, not @TeX{}, @dots{})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12026
msgid ""
"`Raw' formatter text for any output format, passed straight through with "
"minimal (but not zero) interpretation of @@-commands."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12030
msgid ""
"Format-independent variable substitutions, and testing if a variable is set "
"or clear."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12034
#: texinfo/texinfo-ed.7.1-en_US.texi:12036
#, no-wrap
msgid "Conditional Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12036
msgid "@nodedescription Text for a given format."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12041
msgid ""
"Texinfo has an @code{@@if@var{format}} environment for each output format, "
"to allow conditional inclusion of text for a particular output format."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12042
#, no-wrap
msgid "ifinfo"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12047
msgid ""
"@code{@@ifinfo} begins segments of text that should be ignored when not "
"producing Info output, in particular in printed output.  The segment of text "
"appears only in the Info file and, for historical compatibility, the plain "
"text output."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12048
#, no-wrap
msgid "ifdocbook"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12049
#, no-wrap
msgid "ifhtml"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12050
#, no-wrap
msgid "iflatex"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12051
#, no-wrap
msgid "ifplaintext"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12052
#, no-wrap
msgid "iftex"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12053
#, no-wrap
msgid "ifxml"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12055
msgid "The environments for the other formats are analogous:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12057
#, no-wrap
msgid "@@ifdocbook @dots{} @@end ifdocbook"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12059
msgid "Text to appear only in the DocBook output."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12060
#, no-wrap
msgid "@@ifhtml @dots{} @@end ifhtml"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12062
msgid "Text to appear only in the HTML output."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12063
#, no-wrap
msgid "@@iflatex @dots{} @@end iflatex"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12065
msgid "Text to appear only in the @LaTeX{} output."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12066
#, no-wrap
msgid "@@ifplaintext @dots{} @@end ifplaintext"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12068
msgid "Text to appear only in the plain text output."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12069
#, no-wrap
msgid "@@iftex @dots{} @@end iftex"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12071
msgid "Text to appear only in the printed manual."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12072
#, no-wrap
msgid "@@ifxml @dots{} @@end ifxml"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12074
msgid "Text to appear only in the XML output."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12080
msgid ""
"The @code{@@if@dots{}} and @code{@@end if@dots{}} commands must appear on "
"lines by themselves in your source file.  The newlines following the "
"commands are (more or less) treated as whitespace, so that the conditional "
"text is flowed normally into a surrounding paragraph."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12084
msgid ""
"The @code{@@if@dots{}} constructs are intended to conditionalize normal "
"Texinfo source; @pxref{Raw Formatter Commands}, for using underlying format "
"commands directly."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12086
msgid "Here is an example showing all these conditionals:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12109
#, no-wrap
msgid ""
"@@iftex\n"
"This text will appear only in the printed manual.\n"
"@@end iftex\n"
"@@ifinfo\n"
"However, this text will appear only in Info and plain text.\n"
"@@end ifinfo\n"
"@@ifhtml\n"
"And this text will only appear in HTML.\n"
"@@end ifhtml\n"
"@@iflatex\n"
"Moreover, this text will only appear in @@LaTeX@{@}.\n"
"@@end iflatex\n"
"@@ifplaintext\n"
"Whereas this text will only appear in plain text.\n"
"@@end ifplaintext\n"
"@@ifxml\n"
"Notwithstanding that this will only appear in XML@.\n"
"@@end ifxml\n"
"@@ifdocbook\n"
"Nevertheless, this will only appear in DocBook.\n"
"@@end ifdocbook\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12113
msgid "The preceding example produces the following line:"
msgstr ""

#. type: iftex
#: texinfo/texinfo-ed.7.1-en_US.texi:12116
msgid "This text will appear only in the printed manual."
msgstr ""

#. type: ifinfo
#: texinfo/texinfo-ed.7.1-en_US.texi:12119
msgid "However, this text will appear only in Info and plain text."
msgstr ""

#. type: ifhtml
#: texinfo/texinfo-ed.7.1-en_US.texi:12122
msgid "And this text will only appear in HTML."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12125
msgid "@iflatex Moreover, this text will only appear in @LaTeX{}."
msgstr ""

#. type: ifplaintext
#: texinfo/texinfo-ed.7.1-en_US.texi:12128
msgid "Whereas this text will only appear in plain text."
msgstr ""

#. type: ifxml
#: texinfo/texinfo-ed.7.1-en_US.texi:12131
msgid "Notwithstanding that this will only appear in XML@."
msgstr ""

#. type: ifdocbook
#: texinfo/texinfo-ed.7.1-en_US.texi:12134
msgid "Nevertheless, this will only appear in DocBook."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12139
msgid ""
"Notice that you only see one of the input lines, depending on which version "
"of the manual you are reading."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12140
#, no-wrap
msgid "errormsg"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12145
msgid ""
"In complex documents, you may want Texinfo to issue an error message in some "
"conditionals that should not ever be processed.  The "
"@code{@@errormsg@{@var{text}@}} command will do this; it takes one argument, "
"the text of the error message."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12151
msgid ""
"We mention @code{@@errormsg@{@}} here even though it is not strictly related "
"to conditionals, since in practice it is most likely to be useful in that "
"context.  Technically, it can be used anywhere.  @xref{External Macro "
"Processors}, for a caveat regarding the line numbers which @code{@@errormsg} "
"emits in @TeX{}."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12153
#: texinfo/texinfo-ed.7.1-en_US.texi:12155
#, no-wrap
msgid "Conditional Not Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12155
msgid "@nodedescription Text for any format other than a given one."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12156
#, no-wrap
msgid "ifnotdocbook"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12157
#, no-wrap
msgid "ifnothtml"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12158
#, no-wrap
msgid "ifnotinfo"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12159
#, no-wrap
msgid "ifnotlatex"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12160
#, no-wrap
msgid "ifnotplaintext"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12161
#, no-wrap
msgid "ifnottex"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12162
#, no-wrap
msgid "ifnotxml"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12166
msgid ""
"You can specify text to be included in any output format @emph{other} than a "
"given one with the @code{@@ifnot@dots{}} environments:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12175
#, no-wrap
msgid ""
"@@ifnotdocbook @dots{} @@end ifnotdocbook\n"
"@@ifnothtml @dots{} @@end ifnothtml\n"
"@@ifnotinfo @dots{} @@end ifnotinfo\n"
"@@ifnotlatex @dots{} @@end ifnotlatex\n"
"@@ifnotplaintext @dots{} @@end ifnotplaintext\n"
"@@ifnottex @dots{} @@end ifnottex\n"
"@@ifnotxml @dots{} @@end ifnotxml\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12180
msgid ""
"The @code{@@ifnot@dots{}} command and the @code{@@end} command must appear "
"on lines by themselves in your actual source file."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12183
msgid ""
"If the output file is being made in the given format, the region is "
"@emph{ignored}.  Otherwise, it is included."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12188
msgid ""
"There is one exception (for historical compatibility): @code{@@ifnotinfo} "
"text is omitted for both Info and plain text output, not just Info.  To "
"specify text which appears only in Info and not in plain text, use "
"@code{@@ifnotplaintext}, like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12195
#, no-wrap
msgid ""
"@@ifinfo\n"
"@@ifnotplaintext\n"
"This will be in Info, but not plain text.\n"
"@@end ifnotplaintext\n"
"@@end ifinfo\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12200
msgid ""
"The regions delimited by these commands are ordinary Texinfo source as with "
"@code{@@iftex}, not raw formatter source as with @code{@@tex} (@pxref{Raw "
"Formatter Commands})."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12202
#: texinfo/texinfo-ed.7.1-en_US.texi:12204
#, no-wrap
msgid "Raw Formatter Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12204
msgid "@nodedescription Using raw formatter commands."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12205
#, no-wrap
msgid "Raw formatter commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12207
#, no-wrap
msgid "@TeX{} commands, using ordinary"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12208
#, no-wrap
msgid "Ordinary @TeX{} commands, using"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12209
#, no-wrap
msgid "Commands using raw @TeX{}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12210
#, no-wrap
msgid "Plain @TeX{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12220
msgid ""
"The @code{@@if@dots{}} conditionals just described must be used only with "
"normal Texinfo source.  For instance, most features of plain @TeX{} will not "
"work within @code{@@iftex}.  The purpose of @code{@@if@dots{}} is to provide "
"conditional processing for Texinfo source, not provide access to underlying "
"formatting features.  For that, Texinfo provides so-called @dfn{raw "
"formatter commands}.  They should only be used when truly required (most "
"documents do not need them)."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12222
#, no-wrap
msgid "Category codes, of plain @TeX{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12231
msgid ""
"The first raw formatter command is @code{@@tex}.  You can enter plain @TeX{} "
"completely, and use @samp{\\} in the @TeX{} commands, by delineating a "
"region with the @code{@@tex} and @code{@@end tex} commands.  All plain "
"@TeX{} commands and category codes are restored within a @code{@@tex} "
"region.  The sole exception is that the @code{@@} character still introduces "
"a command, so that @code{@@end tex} can be recognized.  Texinfo processors "
"will not output material in such a region unless @TeX{} output is being "
"produced."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12232
#, no-wrap
msgid "\\gdef @r{within @code{@@tex}}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12233
#, no-wrap
msgid "\\globaldefs @r{within @code{@@tex}}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12241
msgid ""
"In complex cases, you may wish to define new @TeX{} macros within "
"@code{@@tex}.  You must use @code{\\gdef} to do this, not @code{\\def}, "
"because @code{@@tex} regions are processed in a @TeX{} group.  If you need "
"to make several definitions, you may wish to set @code{\\globaldefs=1} (its "
"value will be restored to zero as usual when the group ends at @code{@@end "
"tex}, so it won't cause problems with the rest of the document)."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12242
#, no-wrap
msgid "Equation, displayed, in plain @TeX{}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12243
#, no-wrap
msgid "Displayed equation, in plain @TeX{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12245
msgid "As an example, here is a displayed equation written in plain @TeX{}:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12252
#, no-wrap
msgid ""
"@@tex\n"
"$$ \\chi^2 = \\sum_@{i=1@}^N\n"
"         \\left (y_i - (a + b x_i)\n"
"         \\over \\sigma_i\\right)^2 $$\n"
"@@end tex\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12258
msgid ""
"The output of this example will appear only in a printed manual.  If you are "
"reading this in a format not generated by @TeX{}, you will not see the "
"equation that appears in the printed manual."
msgstr ""

#. type: tex
#: texinfo/texinfo-ed.7.1-en_US.texi:12263
#, no-wrap
msgid ""
"$$ \\chi^2 = \\sum_{i=1}^N\n"
"         \\left(y_i - (a + b x_i)\n"
"         \\over \\sigma_i\\right)^2 $$\n"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12265
#, no-wrap
msgid "HTML, including raw"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:12266
#: texinfo/texinfo-ed.7.1-en_US.texi:15482
#, no-wrap
msgid "html"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12267
#, no-wrap
msgid "DocBook, including raw"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12268
#: texinfo/texinfo-ed.7.1-en_US.texi:15478
#, no-wrap
msgid "docbook"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12269
#, no-wrap
msgid "@LaTeX{}, including raw"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12270
#, no-wrap
msgid "latex"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12271
#, no-wrap
msgid "XML, including raw"
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:12272
#: texinfo/texinfo-ed.7.1-en_US.texi:15487
#, no-wrap
msgid "xml"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12278
msgid ""
"Analogously, you can use @code{@@html @dots{} @@end html} for a region of "
"raw HTML, @code{@@docbook @dots{} @@end docbook} for a region of raw "
"DocBook, @code{@@latex @dots{} @@end latex} for a region of raw @LaTeX{}, "
"and @code{@@xml @dots{} @@end xml} for a region of raw XML@."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12280
msgid "The behavior of newlines in raw regions is unspecified."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12289
msgid ""
"In all cases, in raw processing, @code{@@} retains the same meaning as in "
"the remainder of the document.  Thus, the Texinfo processors must recognize "
"and even execute, to some extent, the contents of the raw regions, "
"regardless of the final output format.  Therefore, specifying changes that "
"globally affect the document inside a raw region leads to unpredictable and "
"generally undesirable behavior.  For example, using the "
"@code{@@kbdinputstyle} command inside a raw region is undefined.  The remedy "
"is simple: don't do that."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12291
#, no-wrap
msgid "Inline Conditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12293
msgid "@nodedescription Brace-delimited conditional text."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12293
#, no-wrap
msgid ""
"Inline Conditionals: @code{@@inline}, @code{@@inlineifelse}, "
"@code{@@inlineraw}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12294
#, no-wrap
msgid "inlinefmt"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12295
#, no-wrap
msgid "inlinefmtifelse"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12296
#, no-wrap
msgid "inlineraw"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12297
#, no-wrap
msgid "Inline conditionals"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12298
#, no-wrap
msgid "Conditional commands, inline"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12299
#, no-wrap
msgid "Brace-delimited conditional text"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12300
#, no-wrap
msgid "Newlines, avoiding in conditionals"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12301
#, no-wrap
msgid "Whitespace, controlling in conditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12305
msgid ""
"Texinfo provides a set of conditional commands with arguments given within "
"braces:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12307
#, no-wrap
msgid "@@inlinefmt@{@var{format}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12310
msgid ""
"Process the Texinfo @var{text} if @var{format} output is being generated."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12311
#, no-wrap
msgid "@@inlinefmtifelse@{@var{format}, @var{then-text}, @var{else-text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12314
msgid ""
"Process the Texinfo @var{then-text} if @var{format} output is being "
"generated; otherwise, process @var{else-text}."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12315
#, no-wrap
msgid "@@inlineraw@{@var{format}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12317
msgid "Similar, but for raw @var{text} (@pxref{Raw Formatter Commands})."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12320
msgid "The supported @var{format} names are:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12323
#, no-wrap
msgid "docbook  html  info  latex  plaintext  tex  xml\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12329
#, no-wrap
msgid "@@inlinefmt@{html, @@emph@{HTML-only text@}@}\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12337
#, no-wrap
msgid ""
"@@ifhtml\n"
"@@emph@{HTML-only text@}\n"
"@@end ifhtml\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12341
msgid "(environment) case."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12345
msgid ""
"In these commands, whitespace is ignored after the comma separating the "
"arguments, as usual, but is @emph{not} ignored at the end of @var{text}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12351
msgid ""
"To insert a literal at sign, left brace, or right brace in one of the "
"arguments, you must use the alphabetic commands @code{@@atchar@{@}} "
"(@pxref{Inserting an Atsign}), and @code{@@lbracechar@{@}} or "
"@code{@@rbracechar@{@}} (@pxref{Inserting Braces}), or the parsing will "
"become confused."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12357
msgid ""
"With @code{@@inlinefmtifelse}, it is also necessary to use "
"@code{@@comma@{@}} to avoid mistaking a @samp{,} in the text for the "
"delimiter.  With @code{@@inlinefmt} and @code{@@inlineraw}, "
"@code{@@comma@{@}} is not required (though it's fine to use it), since these "
"commands always have exactly two arguments."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12360
msgid ""
"For @TeX{}, the processed @var{text} cannot contain newline-delimited "
"commands.  Text to be ignored (i.e., for non-@TeX{}) can, though."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12363
msgid ""
"Two other @code{@@inline...} conditionals complement the @code{@@ifset} and "
"@code{@@ifclear} commands; see the next section."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12365
#, no-wrap
msgid "@code{@@set @@clear @@value}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12367
msgid "@nodedescription Variable tests and substitutions."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12367
#, no-wrap
msgid "Flags: @code{@@set}, @code{@@clear}, conditionals, and @code{@@value}"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:12373
msgid "set clear value"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12373
msgid ""
"You can direct the Texinfo formatting commands to format or ignore parts of "
"a Texinfo file with the @code{@@set}, @code{@@clear}, @code{@@ifset}, and "
"@code{@@ifclear} commands.  Here is a summary:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12375
#, no-wrap
msgid "@@set @var{flag} [@var{value}]"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12377
msgid "Set the variable @var{flag}, to the optional @var{value} if specified."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12378
#: texinfo/texinfo-ed.7.1-en_US.texi:18700
#, no-wrap
msgid "@@clear @var{flag}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12380
msgid ""
"Undefine the variable @var{flag}, whether or not it was previously defined."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12381
#, no-wrap
msgid "@@ifset @var{flag}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12385
msgid ""
"If @var{flag} is set, text through the next @code{@@end ifset} command is "
"formatted.  If @var{flag} is clear, text through the following @code{@@end "
"ifset} command is ignored."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12386
#, no-wrap
msgid "@@inlineifset@{@var{flag}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12388
msgid "Brace-delimited version of @code{@@ifset}."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12389
#, no-wrap
msgid "@@ifclear @var{flag}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12393
msgid ""
"If @var{flag} is set, text through the next @code{@@end ifclear} command is "
"ignored.  If @var{flag} is clear, text through the following @code{@@end "
"ifclear} command is formatted."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12394
#, no-wrap
msgid "@@inlineifclear@{@var{flag}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12396
msgid "Brace-delimited version of @code{@@ifclear}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12400
#, no-wrap
msgid "@code{@@set @@value}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12402
msgid "@nodedescription Expand a flag variable to a string."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:12402
#, no-wrap
msgid "@code{@@set} and @code{@@value}"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:12405
msgid "set value"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12405
#, no-wrap
msgid "set"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12406
#, no-wrap
msgid "value"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12407
#, no-wrap
msgid "clear"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12411
msgid ""
"You use the @code{@@set} command to specify a value for a flag, which is "
"later expanded by the @code{@@value} command."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12419
msgid ""
"A @dfn{flag} (aka @dfn{variable}) name is an identifier starting with an "
"alphanumeric, @samp{-}, or @samp{_}.  Subsequent characters, if any, may not "
"be whitespace, @samp{@@}, braces, angle brackets, or any of @samp{~`^+|}; "
"other characters, such as @samp{%}, may work.  However, it is best to use "
"only letters and numerals in a flag name, not @samp{-} or @samp{_} or "
"others---they will work in some contexts, but not all, due to limitations in "
"@TeX{}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12421
msgid "The value is the remainder of the input line, and can contain anything."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12428
msgid "Write the @code{@@set} command like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12431
#, no-wrap
msgid "@@set foo This is a string.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12435
msgid "This sets the value of the flag @code{foo} to ``This is a string.''."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12439
msgid ""
"The Texinfo processors then replace a @code{@@value@{@var{flag}@}} command "
"with the string to which @var{flag} is set.  Thus, when @code{foo} is set as "
"shown above, the Texinfo processors convert this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12443
#, no-wrap
msgid "@@value@{foo@}\n"
msgstr ""

#. type: exdent
#: texinfo/texinfo-ed.7.1-en_US.texi:12443
#, no-wrap
msgid "@r{to this:}"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12445
#, no-wrap
msgid "This is a string.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12450
msgid ""
"You can write a @code{@@value} command within a paragraph; but you must "
"write a @code{@@set} command on a line of its own."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12452
msgid "If you write the @code{@@set} command like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12455
#, no-wrap
msgid "@@set foo\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12459
msgid ""
"without specifying a string, the value of @code{foo} is the empty string."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12462
msgid ""
"If you clear a previously set flag with @code{@@clear @var{flag}}, a "
"subsequent @code{@@value@{flag@}} command will report an error."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12464
msgid "For example, if you set @code{foo} as follows:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12467
#, no-wrap
msgid "@@set howmuch very, very, very\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12471
#: texinfo/texinfo-ed.7.1-en_US.texi:12488
msgid "then the processors transform"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12475
#: texinfo/texinfo-ed.7.1-en_US.texi:12492
#, no-wrap
msgid "It is a @@value@{howmuch@} wet day.\n"
msgstr ""

#. type: exdent
#: texinfo/texinfo-ed.7.1-en_US.texi:12475
#: texinfo/texinfo-ed.7.1-en_US.texi:12492
#, no-wrap
msgid "@r{into}"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12477
#, no-wrap
msgid "It is a very, very, very wet day.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12481
msgid "If you write"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12484
#, no-wrap
msgid "@@clear howmuch\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12494
#, no-wrap
msgid "It is a @{No value for \"howmuch\"@} wet day.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12499
msgid ""
"@code{@@value} cannot be reliably used as the argument to an accent command "
"(@pxref{Inserting Accents}).  For example, this fails:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12504
#, no-wrap
msgid ""
"@@set myletter a\n"
"@@'@@value@{myletter@}    @c fails!\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12507
#, no-wrap
msgid "@code{@@ifset @@ifclear}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12509
msgid "@nodedescription Format a region if a flag is set."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:12509
#, no-wrap
msgid "@code{@@ifset} and @code{@@ifclear}"
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:12512
msgid "ifset ifclear"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12512
#, no-wrap
msgid "ifset"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12519
msgid ""
"When a @var{flag} is set, the Texinfo formatting commands format text "
"between subsequent pairs of @code{@@ifset @var{flag}} and @code{@@end ifset} "
"commands.  When the @var{flag} is cleared, the Texinfo formatting commands "
"do @emph{not} format the text.  @code{@@ifclear} operates analogously."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12522
msgid ""
"Write the conditionally formatted text between @code{@@ifset @var{flag}} and "
"@code{@@end ifset} commands, like this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12528
#, no-wrap
msgid ""
"@@ifset @var{flag}\n"
"@var{conditional-text}\n"
"@@end ifset\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12533
msgid ""
"For example, you can create one document that has two variants, such as a "
"manual for a `large' and `small' model:"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12534
#, no-wrap
msgid "Shrubbery"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12538
#, no-wrap
msgid ""
"You can use this machine to dig up shrubs\n"
"without hurting them.\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12540
#, no-wrap
msgid ""
"@@set large\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12544
#, no-wrap
msgid ""
"@@ifset large\n"
"It can also dig up fully grown trees.\n"
"@@end ifset\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12546
#, no-wrap
msgid "Remember to replant promptly @dots{}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12552
msgid ""
"In the example, the formatting commands will format the text between "
"@code{@@ifset large} and @code{@@end ifset} because the @code{large} flag is "
"set."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12556
msgid ""
"When @var{flag} is cleared, the Texinfo formatting commands do @emph{not} "
"format the text between @code{@@ifset @var{flag}} and @code{@@end ifset}; "
"that text is ignored and does not appear in the output."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12565
msgid ""
"For example, if you clear the flag of the preceding example by writing an "
"@code{@@clear large} command after the @code{@@set large} command (but "
"before the conditional text), then the Texinfo formatting commands ignore "
"the text between the @code{@@ifset large} and @code{@@end ifset} commands.  "
"In the formatted output, that text does not appear; you see only the lines "
"that say, ``You can use this machine to dig up shrubs without hurting them.  "
"Remember to replant promptly @dots{}''."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12566
#, no-wrap
msgid "ifclear"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12574
msgid ""
"If a flag is cleared with a @code{@@clear @var{flag}} command, then the "
"formatting commands format text between subsequent pairs of @code{@@ifclear} "
"and @code{@@end ifclear} commands.  But if the flag is set with @code{@@set "
"@var{flag}}, then the formatting commands do @emph{not} format text between "
"an @code{@@ifclear} and an @code{@@end ifclear} command; rather, they ignore "
"that text.  An @code{@@ifclear} command looks like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12577
#, no-wrap
msgid "@@ifclear @var{flag}\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12580
#, no-wrap
msgid "@code{@@inlineifset @@inlineifclear}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12582
msgid "@nodedescription Brace-delimited flag conditionals."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:12582
#, no-wrap
msgid "@code{@@inlineifset} and @code{@@inlineifclear}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12584
#, no-wrap
msgid "inlineifset"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12585
#, no-wrap
msgid "inlineifclear"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12586
#, no-wrap
msgid "Flag conditionals, brace-delimited"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12587
#, no-wrap
msgid "Brace-delimited flag conditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12594
msgid ""
"@code{@@inlineifset} and @code{@@inlineifclear} provide brace-delimited "
"alternatives to the @code{@@ifset} and @code{@@ifclear} forms, similar to "
"the other @code{@@inline...} Commands (@pxref{Inline Conditionals}).  The "
"same caveats about argument parsing given there apply here too."
msgstr ""

#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:12596
#: texinfo/texinfo-ed.7.1-en_US.texi:19225
#, no-wrap
msgid "@@inlineifset@{@var{var}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12598
msgid "Process the Texinfo @var{text} if the flag @var{var} is defined."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:12599
#: texinfo/texinfo-ed.7.1-en_US.texi:19224
#, no-wrap
msgid "@@inlineifclear@{@var{var}, @var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:12601
msgid "Process the Texinfo @var{text} if the flag @var{var} is not defined."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12606
msgid ""
"Except for the syntax, their general behavior and purposes is the same as "
"with @code{@@ifset} and @code{@@ifclear}, described in the previous section."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:12608
#: texinfo/texinfo-ed.7.1-en_US.texi:12610
#, no-wrap
msgid "@code{@@value} Example"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12610
msgid "@nodedescription An easy way to update edition information."
msgstr ""

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo-ed.7.1-en_US.texi:12613
msgid "value Example"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12618
msgid ""
"You can use the @code{@@value} command to minimize the number of places you "
"need to change when you record an update to a manual.  @xref{GNU Sample "
"Texts}, for the full text of an example of using this to work with Automake "
"distributions."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12620
msgid "This example is adapted from @ref{Top,,, make, The GNU Make Manual}."
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12624
msgid "Set the flags:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12631
#, no-wrap
msgid ""
"@@set EDITION 0.35 Beta\n"
"@@set VERSION 3.63 Beta\n"
"@@set UPDATED 14 August 1992\n"
"@@set UPDATE-MONTH August 1992\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12636
msgid "Write text for the @code{@@copying} section (@pxref{@code{@@copying}}):"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12644
#, no-wrap
msgid ""
"@@copying\n"
"This is Edition @@value@{EDITION@},\n"
"last updated @@value@{UPDATED@},\n"
"of @@cite@{The GNU Make Manual@},\n"
"for @@code@{make@}, version @@value@{VERSION@}.\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12646
#, no-wrap
msgid ""
"Copyright @dots{}\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12649
#, no-wrap
msgid ""
"Permission is granted @dots{}\n"
"@@end copying\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12654
msgid "Write text for the title page, for people reading the printed manual:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12666
#, no-wrap
msgid ""
"@@titlepage\n"
"@@title GNU Make\n"
"@@subtitle A Program for Directing Recompilation\n"
"@@subtitle Edition @@value@{EDITION@}, @dots{}\n"
"@@subtitle @@value@{UPDATE-MONTH@}\n"
"@@page\n"
"@@insertcopying\n"
"@dots{}\n"
"@@end titlepage\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12672
msgid ""
"(On a printed cover, a date listing the month and the year looks less fussy "
"than a date listing the day as well as the month and year.)"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12675
msgid "Write text for the Top node, for people reading the Info file:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12681
#, no-wrap
msgid ""
"@@ifnottex\n"
"@@node Top\n"
"@@top Make\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12687
#, no-wrap
msgid ""
"This is Edition @@value@{EDITION@},\n"
"last updated @@value@{UPDATED@},\n"
"of @@cite@{The GNU Make Manual@},\n"
"for @@code@{make@}, version @@value@{VERSION@}.\n"
"@@end ifnottex\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:12692
msgid ""
"After you format the manual, the @code{@@value} constructs have been "
"expanded, so the output contains text like this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:12697
#, no-wrap
msgid ""
"This is Edition 0.35 Beta, last updated 14 August 1992,\n"
"of `The GNU Make Manual', for `make', Version 3.63 Beta.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12703
msgid ""
"When you update the manual, you change only the values of the flags; you do "
"not need to edit the three sections."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:12705
#, no-wrap
msgid "Testing for Texinfo Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12707
msgid "@nodedescription Testing if a Texinfo command is available."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12707
#, no-wrap
msgid ""
"Testing for Texinfo Commands: @code{@@ifcommanddefined}, "
"@code{@@ifcommandnotdefined}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12709
#, no-wrap
msgid "Testing for Texinfo commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12710
#, no-wrap
msgid "Checking for Texinfo commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12711
#, no-wrap
msgid "Texinfo commands, testing for"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12712
#, no-wrap
msgid "Commands, testing for Texinfo"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12713
#, no-wrap
msgid "Versions of Texinfo, adapting to"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12714
#, no-wrap
msgid "Features of Texinfo, adapting to"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12715
#, no-wrap
msgid "ifcommanddefined"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12716
#, no-wrap
msgid "ifcommandnotdefined"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12723
msgid ""
"Occasionally, you may want to arrange for your manual to test if a given "
"Texinfo command is available and (presumably) do some sort of fallback "
"formatting if not.  There are conditionals @code{@@ifcommanddefined} and "
"@code{@@ifcommandnotdefined} to do this.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12728
#, no-wrap
msgid ""
"@@ifcommanddefined node\n"
"Good, @@samp@{@@@@node@} is defined.\n"
"@@end ifcommanddefined\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12739
msgid ""
"This conditional will also consider any new commands defined by the document "
"via @code{@@macro}, @code{@@alias}, @code{@@definfoenclose}, and "
"@code{@@def@r{(}code@r{)}index} (@pxref{Defining New Texinfo Commands}) to "
"be true.  Caveat: the @TeX{} implementation reports internal @TeX{} "
"commands, in addition to all the Texinfo commands, as being ``defined''; the "
"@code{texi2any} implementation is reliable in this regard, however."
msgstr ""

#. type: pindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12740
#, no-wrap
msgid "@file{NEWS} file for Texinfo"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12745
msgid ""
"You can check the @file{NEWS} file in the Texinfo source distribution and "
"linked from the Texinfo home page "
"(@url{http://www.gnu.org/software/texinfo}) to see when a particular command "
"was added."
msgstr ""

#. type: vindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12746
#, no-wrap
msgid "txicommandconditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12752
msgid ""
"These command-checking conditionals themselves were added in "
"Texinfo@tie{}5.0, released in 2013---decades after Texinfo's inception.  In "
"order to test if they themselves are available, the predefined flag "
"@code{txicommandconditionals} can be tested, like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12759
#, no-wrap
msgid ""
"@@ifset txicommandconditionals\n"
"@@ifcommandnotdefined foobarnode\n"
"(Good, @@samp@{@@@@foobarnode@} is not defined.)\n"
"@@end ifcommandnotdefined\n"
"@@end ifset\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12764
msgid ""
"Since flags (see the previous section) were added early in the existence of "
"Texinfo, there is no problem with assuming they are available."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12771
msgid ""
"We recommend avoiding these tests whenever possible---which is usually the "
"case.  For many software packages, it is reasonable for all developers to "
"have a given version of Texinfo (or newer) installed, and thus no reason to "
"worry about older versions.  (It is straightforward for anyone to download "
"and install the Texinfo source; it does not have any problematic "
"dependencies.)"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12778
msgid ""
"The issue of Texinfo versions does not generally arise for end users.  With "
"properly distributed packages, users need not process the Texinfo manual "
"simply to build and install the package; they can use preformatted Info (or "
"other) output files.  This is desirable in general, to avoid unnecessary "
"dependencies between packages (@pxref{Releases,,, standards, GNU Coding "
"Standards})."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12780
#: texinfo/texinfo-ed.7.1-en_US.texi:12782
#, no-wrap
msgid "Conditional Nesting"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12782
msgid "@nodedescription Using conditionals inside conditionals."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12783
#, no-wrap
msgid "Conditionals, nested"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12784
#, no-wrap
msgid "Nesting conditionals"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12789
msgid ""
"Texinfo requires that for a failing conditional, the ignored text must be "
"properly nested with respect to that failing conditional.  Here's an example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12799
#, no-wrap
msgid ""
"@@ifset somevar\n"
"@@ifset anothervar\n"
"Both somevar and anothervar are set.\n"
"@@end ifset\n"
"@@ifclear anothervar\n"
"Somevar is set, anothervar is not.\n"
"@@end ifclear\n"
"@@end ifset\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12802
msgid "If @samp{somevar} is not set, the whole block is skipped."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12806
msgid ""
"To allow the processors to reliably determine which commands to consider for "
"nesting purposes, all conditional commands must be on lines by themselves, "
"with no text (even spaces) before or after."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12823
#, no-wrap
msgid ""
"@@ifset a\n"
"@@ifset b\n"
"@@ifclear ok  - ok, ignored\n"
"@@end junky   - ok, ignored\n"
"@@end ifset\n"
"@@c WRONG - missing @@end ifset.\n"
msgstr ""

#. type: chapter
#: texinfo/texinfo-ed.7.1-en_US.texi:12829
#: texinfo/texinfo-ed.7.1-en_US.texi:12831
#, no-wrap
msgid "Defining New Texinfo Commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12831
msgid "@nodedescription User-defined macros and aliases."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12833
#, no-wrap
msgid "Macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12834
#, no-wrap
msgid "Defining new Texinfo commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12835
#, no-wrap
msgid "New Texinfo commands, defining"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12836
#, no-wrap
msgid "Texinfo commands, defining new"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12837
#, no-wrap
msgid "User-defined Texinfo commands"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12841
msgid ""
"Texinfo provides several ways to define new commands (in all cases, it's not "
"recommended to try redefining existing commands):"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12848
msgid ""
"A Texinfo @dfn{macro} allows you to define a new Texinfo command as any "
"sequence of text and/or existing commands (including other macros).  The "
"macro can have any number of @dfn{parameters}---text you supply each time "
"you use the macro."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12852
msgid ""
"Incidentally, these macros have nothing to do with the @code{@@defmac} "
"command, which is for documenting macros in the subject area of the manual "
"(@pxref{Def Cmd Template})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12856
msgid ""
"@samp{@@linemacro} allows you to define a macro whose arguments extend to "
"the end of the line and are separated by spaces."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12859
msgid "@samp{@@alias} defines a new name for an existing command."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:12864
msgid ""
"@samp{@@definfoenclose} allows you to define new commands with customized "
"output for some non-printed output formats.  This command is deprecated."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12870
msgid ""
"Most generally of all (not just for defining new commands), it is possible "
"to invoke any external macro processor and have Texinfo recognize so-called "
"@code{#line} directives for error reporting."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12874
msgid ""
"If you want to do simple text substitution, @code{@@set} and @code{@@value} "
"is the simplest approach (@pxref{@code{@@set @@clear @@value}})."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12876
#: texinfo/texinfo-ed.7.1-en_US.texi:12878
#, no-wrap
msgid "Defining Macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12878
msgid "@nodedescription Defining and undefining new commands."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12879
#, no-wrap
msgid "Defining macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12880
#, no-wrap
msgid "Macro definitions, Texinfo"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12882
#, no-wrap
msgid "macro"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12884
msgid ""
"You use the Texinfo @code{@@macro} command to define a macro, like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12889
#, no-wrap
msgid ""
"@@macro @var{macroname}@{@var{param1}, @var{param2}, @dots{}@}\n"
"@var{text} @dots{} \\@var{param1}\\ @dots{}\n"
"@@end macro\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12894
msgid ""
"The @dfn{parameters} @var{param1}, @var{param2}, @dots{} correspond to "
"arguments supplied when the macro is subsequently used in the document "
"(described in the next section)."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12895
#, no-wrap
msgid "Macro names, valid characters in"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12896
#, no-wrap
msgid "Names of macros, valid characters of"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12905
msgid ""
"In principle, @var{macroname} should consist of alphanumerics, and (except "
"as the first character) @samp{-}.  The @samp{_} character is excluded so "
"that macros can be called inside @code{@@math} without a following space "
"(@pxref{Inserting Math}).  However, for a macro to work consistently with "
"@TeX{}, @var{macroname} must consist entirely of letters: no digits, "
"hyphens, or other special characters.  So, we recommend using only letters.  "
"Texinfo commands should not be redefined as macros."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12909
msgid ""
"If a macro needs no parameters, you can define it either with an empty list "
"(@samp{@@macro foo @{@}}) or with no braces at all (@samp{@@macro foo})."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12910
#, no-wrap
msgid "Body of a macro"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12915
msgid ""
"The definition or @dfn{body} of the macro can contain most Texinfo commands, "
"including macro invocations.  However, a macro definition that defines "
"another macro does not work in @TeX{} due to limitations in the design of "
"@code{@@macro}."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12916
#, no-wrap
msgid "Parameters to macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12921
msgid ""
"In the macro body, instances of a parameter name surrounded by backslashes, "
"as in @samp{\\@var{param1}\\} in the example above, are replaced by the "
"corresponding argument from the macro invocation.  You can use parameter "
"names any number of times in the body, including zero."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12922
#, no-wrap
msgid "Backslash in macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12925
msgid ""
"To get a single @samp{\\} in the macro expansion, use @samp{\\\\}.  Any "
"other use of @samp{\\} in the body yields a warning."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12926
#, no-wrap
msgid "Spaces in macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12927
#, no-wrap
msgid "Whitespace in macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12932
msgid ""
"The newline characters after the @code{@@macro} line and before the "
"@code{@@end macro} line are ignored, that is, not included in the macro "
"body.  All other whitespace is treated according to the usual Texinfo rules."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12933
#, no-wrap
msgid "Recursive macro invocations"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12934
#, no-wrap
msgid "rmacro"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12937
msgid ""
"To allow a macro to be used recursively, that is, in an argument to a call "
"to itself, you must define it with @samp{@@rmacro}, like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12944
#, no-wrap
msgid ""
"@@rmacro rmac @{arg@}\n"
"a\\arg\\b\n"
"@@end rmacro\n"
"@dots{}\n"
"@@rmac@{1@@rmac@{text@}2@}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12948
msgid ""
"This produces the output `a1atextb2b'.  With @samp{@@macro} instead of "
"@samp{@@rmacro}, an error message is given."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:12949
#, no-wrap
msgid "unmacro"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12950
#, no-wrap
msgid "Macros, undefining"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12951
#, no-wrap
msgid "Undefining macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12955
msgid ""
"You can undefine a macro @var{foo} with @code{@@unmacro @var{foo}}.  It is "
"not an error to undefine a macro that is already undefined.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12958
#, no-wrap
msgid "@@unmacro foo\n"
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:12961
#: texinfo/texinfo-ed.7.1-en_US.texi:12963
#, no-wrap
msgid "Invoking Macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12963
msgid "@nodedescription Using a macro, once you've defined it."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12965
#, no-wrap
msgid "Invoking macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12966
#, no-wrap
msgid "Expanding macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12967
#, no-wrap
msgid "Running macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12968
#, no-wrap
msgid "Macro invocation"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12972
msgid ""
"After a macro is defined (see the previous section), you can @dfn{invoke} "
"(use) it in your document like this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12975
#, no-wrap
msgid "@@@var{macroname} @{@var{arg1}, @var{arg2}, @dots{}@}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12979
msgid "@var{macroname} at that spot.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:12985
#, no-wrap
msgid ""
"@@macro foo @{p, q@}\n"
"Together: \\p\\ & \\q\\.\n"
"@@end macro\n"
"@@foo@{a, b@}\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:12991
#, no-wrap
msgid "Together: a & b.\n"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:12993
#, no-wrap
msgid "Backslash, and macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:12999
msgid ""
"Thus, the arguments and parameters are separated by commas and delimited by "
"braces; any whitespace after (but not before) a comma is ignored.  The "
"braces are required in the invocation even when the macro takes no "
"arguments, consistent with other Texinfo commands.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13005
#, no-wrap
msgid ""
"@@macro argless @{@}\n"
"No arguments here.\n"
"@@end macro\n"
"@@argless@{@}\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:13011
#, no-wrap
msgid "No arguments here.\n"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13013
#, no-wrap
msgid "Comma, in macro arguments"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13020
msgid ""
"Passing macro arguments containing commas requires care, since commas also "
"separate the arguments.  To include a comma character in an argument, the "
"most reliable method is to use the @code{@@comma@{@}} command.  Another "
"method is to surround the argument with @samp{@@asis@{@dots{}@}}.  For "
"@code{texi2any}, you can also prepend a backslash character, as in "
"@samp{\\,}, but this does not work with @TeX{}."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13021
#, no-wrap
msgid "Automatic quoting of commas for some macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13022
#, no-wrap
msgid "Quoting, automatic for some macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13025
msgid ""
"It's not always necessary to worry about commas.  To facilitate use of "
"macros, two rules for @dfn{automatic quoting} are implemented:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13027
#, no-wrap
msgid "If a macro takes only one argument, all commas in its invocation"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13029
msgid "are quoted by default.  For example:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13035
#, no-wrap
msgid ""
"@@macro TRYME@{text@}\n"
"@@strong@{TRYME: \\text\\@}\n"
"@@end macro\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13037
#, no-wrap
msgid "@@TRYME@{A nice feature, though it can be dangerous.@}\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13042
msgid "will produce the following output"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13045
#, no-wrap
msgid "@strong{TRYME: A nice feature, though it can be dangerous.}\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13050
msgid ""
"And indeed, it can.  Namely, there is no control on the number of arguments "
"passed to one-argument macros, so be careful when you invoke them."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13051
#, no-wrap
msgid "If a macro invocation includes another command (including a"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13054
msgid ""
"recursive invocation of itself), any commas in the nested command "
"invocation(s) are quoted by default.  For example, in"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13057
#, no-wrap
msgid "@@say@{@@strong@{Yes, I do@}, person one@}\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13061
msgid ""
"the comma after @samp{Yes} is implicitly quoted.  Here's another example, "
"with a recursive macro:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13067
#, no-wrap
msgid ""
"@@rmacro cat@{a,b@}\n"
"\\a\\\\b\\\n"
"@@end rmacro\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13069
#, no-wrap
msgid "@@cat@{@@cat@{foo, bar@}, baz@}\n"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13074
msgid "will produce the string @samp{foobarbaz}."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13075
#, no-wrap
msgid "Otherwise, a comma should be explicitly quoted, as above, for it"
msgstr ""

#. type: enumerate
#: texinfo/texinfo-ed.7.1-en_US.texi:13077
msgid "to be treated as a part of an argument."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13079
#, no-wrap
msgid "Backslash, in macro arguments"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13080
#, no-wrap
msgid "Braces, in macro arguments"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13083
msgid ""
"The backslash itself can be quoted in macro arguments with another "
"backslash.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13086
#, no-wrap
msgid "@@@var{macname} @{\\\\bleh@}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13090
msgid "will pass the argument @samp{\\bleh} to @var{macname}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13095
msgid ""
"@command{texi2any} also recognizes @samp{\\@{} and @samp{\\@}} sequences for "
"curly braces, but these are not recognized by the implementation in @TeX{}.  "
"There should, however, rarely be a need for these, as they are only needed "
"when a macro argument contains unbalanced braces."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13099
msgid ""
"If a macro is defined to take exactly one argument, it can be invoked "
"without any braces, taking all of the line after the macro name as the "
"argument.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13105
#, no-wrap
msgid ""
"@@macro bar @{p@}\n"
"Twice: \\p\\ & \\p\\.\n"
"@@end macro\n"
"@@bar aah\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:13111
#, no-wrap
msgid "Twice: aah & aah.\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13116
msgid ""
"In these arguments, there is no escaping of special characters, so each "
"@samp{\\} stands for itself."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13120
msgid ""
"If a macro is defined to take more than one argument, but is called with "
"only one (in braces), the remaining arguments are set to the empty string, "
"and no error is given.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13126
#, no-wrap
msgid ""
"@@macro addtwo @{p, q@}\n"
"Both: \\p\\\\q\\.\n"
"@@end macro\n"
"@@addtwo@{a@}\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:13132
#, no-wrap
msgid "Both: a.\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13135
#, no-wrap
msgid "Macro Details"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13137
msgid "@nodedescription Limitations of Texinfo macros."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13137
#, no-wrap
msgid "Macro Details and Caveats"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13138
#, no-wrap
msgid "Macro details"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13139
#, no-wrap
msgid "Details of macro usage"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13140
#, no-wrap
msgid "Caveats for macro usage"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13142
#, no-wrap
msgid "Macro expansion, contexts for"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13143
#, no-wrap
msgid "Expansion of macros, contexts for"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13145
msgid "By design, macro expansion should not happen in the following contexts:"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13147
#, no-wrap
msgid "@code{@@macro} and @code{@@unmacro} lines;"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13149
#, no-wrap
msgid "@code{@@if...} lines, including @code{@@ifset} and similar;"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13151
#, no-wrap
msgid "@code{@@set}, @code{@@clear}, @code{@@value};"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13153
#, no-wrap
msgid "@code{@@clickstyle} lines;"
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13155
#, no-wrap
msgid "@code{@@end} lines when there is no macro expansion in the block"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13157
msgid "command."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13161
msgid "possibly yielding errors."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13170
msgid ""
"Also, quite a few macro-related constructs cause problems with @TeX{}; some "
"of the caveats are listed below.  Thus, if you get macro-related errors when "
"producing the printed version of a manual, you might try expanding the "
"macros with @command{texi2any} by invoking @command{texi2dvi} with the "
"@samp{-E} option (@pxref{Format with @command{texi2dvi}}).  Or, more "
"reliably, eschew Texinfo macros altogether and use a language designed for "
"macro processing, such as M4 (@pxref{External Macro Processors})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13174
msgid "As mentioned earlier, macro names must consist entirely of letters."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13180
msgid ""
"It is not advisable to redefine any @TeX{} primitive, plain, or Texinfo "
"command name as a macro. Unfortunately, this is a large and open-ended set "
"of names, and the possible resulting errors are unpredictable."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13183
msgid "Arguments to macros taking more than one argument cannot cross lines."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13189
msgid ""
"Macros containing a command which must be on a line by itself, such as a "
"conditional, cannot be invoked in the middle of a line.  Similarly, macros "
"containing line-oriented commands or text, such as @code{@@example} "
"environments, may behave unpredictably in @TeX{}."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13194
msgid ""
"Texinfo commands in the expansion of a macro in the text of an index entry "
"may end up being typeset as literal text (including an ``@@'' sign), instead "
"of being interpreted with their intended meaning."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13197
msgid "White space is ignored at the beginnings of lines."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13201
msgid ""
"Macros can't be reliably used in the argument to accent commands "
"(@pxref{Inserting Accents})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13205
msgid ""
"The backslash escape for commas in macro arguments does not work; "
"@code{@@comma@{@}} must be used."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13213
msgid ""
"Ending a macro body with @samp{@@c} may cause text following the macro "
"invocation to be ignored as a comment in @command{texi2any}.  This is not "
"the case when processing with @TeX{}.  This was often done to ``comment "
"out'' an unwanted newline at the end of a macro body, but this is not "
"necessary any more, as the final newline before @samp{@@end macro} is not "
"included in the macro body anyway."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13220
msgid ""
"In general, you can't arbitrarily substitute a macro (or @code{@@value}) "
"call for Texinfo command arguments, even when the text is the same.  Texinfo "
"is not M4 (or even plain @TeX{}).  It might work with some commands, it "
"fails with others.  Best not to do it at all.  For instance, this fails:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13226
#, no-wrap
msgid ""
"@@macro offmacro\n"
"off\n"
"@@end macro\n"
"@@headings @@offmacro\n"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13232
msgid ""
"This looks equivalent to @code{@@headings off}, but for @TeX{}nical reasons, "
"it fails with a mysterious error message (namely, @samp{Paragraph ended "
"before @@headings was complete})."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13236
msgid ""
"Expanding macros in a math context may lead to poor spacing in @TeX{} "
"output.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13243
#, no-wrap
msgid ""
"@@iftex\n"
"@@macro atan\n"
"\\\\mathop@{\\\\rm atan@}\n"
"@@end macro\n"
"@@end iftex\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13245
#, no-wrap
msgid "@@math@{@@atan@{@}(x)@}\n"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13250
msgid ""
"The braces following @samp{@@atan} are treated by @TeX{} as a subformula, "
"leading to extra space before the opening parenthesis.  You can work around "
"this by defining a raw @TeX{} macro instead:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13255
#, no-wrap
msgid ""
"@@tex\n"
"\\gdef\\atan#1@{\\mathop@{\\rm atan@}@}\n"
"@@end tex\n"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13259
msgid ""
"The @samp{#1} in this definition absorbs the braces, so that the spacing is "
"as expected for the @code{\\mathop} object."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13264
msgid ""
"If you have problems using conditionals within a macro, an alternative is to "
"use separate macro definitions inside conditional blocks.  For example, "
"instead of"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13275
#, no-wrap
msgid ""
"@@macro Mac\n"
"@@iftex\n"
"text for TeX output\n"
"@@end iftex\n"
"@@ifnottex\n"
"text for not TeX output\n"
"@@end ifnottex\n"
"@@end macro\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13287
#, no-wrap
msgid ""
"@@iftex\n"
"@@macro Mac\n"
"text for TeX output\n"
"@@end macro\n"
"@@end iftex\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13293
#, no-wrap
msgid ""
"@@ifnottex\n"
"@@macro Mac\n"
"text for not TeX output\n"
"@@end macro\n"
"@@end ifnottex\n"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13301
msgid ""
"Macros cannot define macros in the natural way.  To do this, you must use "
"conditionals and raw @TeX{}.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13314
#, no-wrap
msgid ""
"@@ifnottex\n"
"@@macro ctor @{name, arg@}\n"
"@@macro \\n"
"ame\\\n"
"something involving \\arg\\ somehow\n"
"@@end macro\n"
"@@end macro\n"
"@@end ifnottex\n"
"@@tex\n"
"\\gdef\\ctor#1@{\\ctorx#1,@}\n"
"\\gdef\\ctorx#1,#2,@{\\def#1@{something involving #2 somehow@}@}\n"
"@@end tex\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13318
msgid "The following limitations are by design:"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13327
msgid ""
"If you want to pass an argument with the Texinfo command @code{@@,} (to "
"produce a cedilla, see @ref{Inserting Accents}), you have to use "
"@code{@@value} or another workaround.  Otherwise, the comma may be taken as "
"separating the arguments.  With @command{texi2any}, the comma can be escaped "
"by a backslash.  With @TeX{} another workaround need to be used, therefore "
"we recommend using such a workaround."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13336
#, no-wrap
msgid ""
"@@macro mactwo@{argfirst, argsecond@}\n"
"\\argfirst\\+\\argsecond\\.\n"
"@@end macro\n"
"@@set fc Fran@@,cois\n"
"@@mactwo@{@@value@{fc@},@}\n"
msgstr ""

#. type: display
#: texinfo/texinfo-ed.7.1-en_US.texi:13342
#, no-wrap
msgid "Fran@,cois+.\n"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13353
msgid ""
"@code{@@verbatim} and macros do not mix; for instance, you can't start a "
"verbatim block inside a macro and end it outside "
"(@pxref{@code{@@verbatim}}).  Starting any environment inside a macro and "
"ending it outside may or may not work, for that matter."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13360
msgid ""
"Macros that completely define macros are ok, but it's not possible to have "
"incompletely nested macro definitions.  That is, @code{@@macro} and "
"@code{@@end macro} (likewise for @code{@@rmacro}) must be correctly paired.  "
"For example, you cannot start a macro definition within a macro, and then "
"end that nested definition outside the macro."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13367
msgid ""
"In the @command{makeinfo} implementation before Texinfo 5.0, ends of lines "
"from expansion of a @code{@@macro} definition did not end an @@-command "
"line-delimited argument (@code{@@chapter}, @code{@@center}, etc.).  This is "
"no longer the case.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13374
#, no-wrap
msgid ""
"@@macro twolines@{@}\n"
"aaa\n"
"bbb\n"
"@@end macro\n"
"@@center @@twolines@{@}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13377
msgid "In the current @code{texi2any}, this is equivalent to:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13381
#, no-wrap
msgid ""
"@@center aaa\n"
"bbb\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13385
msgid "the earlier implementation, it would have been parsed as this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13388
#, no-wrap
msgid "@@center aaa bbb\n"
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13391
#, no-wrap
msgid "@code{@@alias}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13393
msgid "@nodedescription Command aliases."
msgstr ""

#. type: item
#: texinfo/texinfo-ed.7.1-en_US.texi:13393
#: texinfo/texinfo-ed.7.1-en_US.texi:18604
#, no-wrap
msgid "@@alias @var{new}=@var{existing}"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13396
#: texinfo/texinfo-ed.7.1-en_US.texi:13398
#, no-wrap
msgid "alias"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13396
#, no-wrap
msgid "Aliases, command"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13397
#, no-wrap
msgid "Command aliases"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13404
msgid ""
"The @samp{@@alias} command defines a new command to be just like an existing "
"one.  This is useful for defining additional markup names, thus preserving "
"additional semantic information in the input even though the output result "
"may be the same."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13409
msgid ""
"Write the @samp{@@alias} command on a line by itself, followed by the new "
"command name, an equals sign, and the existing command name.  Whitespace "
"around the equals sign is optional and ignored if present.  Thus:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13412
#, no-wrap
msgid "@@alias @var{new} = @var{existing}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13419
msgid ""
"For example, if your document contains citations for both books and some "
"other media (movies, for example), you might like to define a macro "
"@code{@@moviecite@{@}} that does the same thing as an ordinary "
"@code{@@cite@{@}} but conveys the extra semantic information as well.  You'd "
"do this as follows:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13422
#, no-wrap
msgid "@@alias moviecite = cite\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13427
msgid ""
"Macros do not always have the same effect as aliases, due to vagaries of "
"argument parsing.  Also, aliases are much simpler to define than macros.  So "
"the command is not redundant."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13430
msgid ""
"Unfortunately, it's not possible to alias Texinfo environments; for example, "
"@code{@@alias lang=example} is an error."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13432
msgid "Aliases must not be recursive, directly or indirectly."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13437
msgid ""
"It is not advisable to redefine any @TeX{} primitive, plain @TeX{}, or "
"Texinfo command name as an alias.  Unfortunately this is a very large set of "
"names, and the possible resulting errors from @TeX{} are unpredictable."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13442
msgid ""
"Alias identifiers should be the same as for macro names, that is "
"alphanumerics and (except as the first character) @samp{-}.  However, with "
"@TeX{}, letters only should be used.  So, we recommend using only letters."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13444
#: texinfo/texinfo-ed.7.1-en_US.texi:13446
#, no-wrap
msgid "Line Macros"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13446
msgid "@nodedescription Macros using whole line for arguments."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13448
#, no-wrap
msgid "linemacro"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13449
#, no-wrap
msgid "Line macros"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13450
#, no-wrap
msgid "Macros taking whole line as an argument"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13454
msgid ""
"You can also define a macro using the @samp{@@linemacro} command.  The "
"syntax for line macro definitions is similar to that for @code{@@macro}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13460
msgid ""
"However, the syntax for using a macro defined this way is different.  The "
"macro call uses the rest of the line, with arguments separated by spaces.  "
"The line macro facility is mainly intended to allow you to define commands "
"that operate similarly to the builtin commands for providing definitions "
"(@pxref{Definition Commands})."
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13467
#, no-wrap
msgid ""
"@@linemacro defbuiltin @{name, args@}\n"
"@@defline @{Builtin@} \\n"
"ame\\ \\args\\\n"
"@@end linemacro\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13470
msgid "The above macro may be used as"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13476
#, no-wrap
msgid ""
"@@defblock\n"
"@@defbuiltin foo (bar)\n"
"Explanation\n"
"@@end defblock\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13479
msgid "This produces the following result:"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13482
msgid ""
"@linemacro defbuiltin {name, args} @defline {Builtin} \\n"
"ame\\ \\args\\"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13487
msgid "@defblock @defbuiltin foo (bar)  Explanation"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13492
msgid ""
"Here the first argument is @samp{foo}, and is substituted where @samp{\\n"
"ame\\} appears in the macro body.  Likewise, @samp{(bar)} is substituted for "
"@samp{\\args\\}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13499
msgid ""
"You can include spaces in a macro argument by surrounding the argument by "
"braces.  Any pair of braces enclosing an argument is removed before "
"substitution.  Any empty arguments (including the last one)  must be given "
"as @samp{@{@}}.  Additionally, non-initial spaces may appear in the final "
"argument in the argument list without surrounding braces (as in the example "
"below)."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13506
msgid ""
"If an argument line for a line macro ends in a @samp{@@} character, then "
"this character together with the following newline are included in a macro "
"argument, and the following line in the input file is also used to get the "
"arguments for the macro.  Note that any substitution of the "
"@samp{@@@var{<newline>}} sequence must be in a valid context, such as a "
"definition line (@pxref{Def Cmd Continuation Lines})."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13508
msgid "Another example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13514
#, no-wrap
msgid ""
"@@linemacro deffunc @{type, name, args@}\n"
"@@findex \\n"
"ame\\\n"
"@@deftypeline @{Func@} @{\\type\\@} \\n"
"ame\\ \\args\\\n"
"@@end linemacro\n"
"\n"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13520
#, no-wrap
msgid ""
"@@defblock\n"
"@@deffunc @{long int@} F (int @@var@{one@}, int @@var@{two@}, @@\n"
"int @@var@{three@}, int @@var@{four@}, int @@var@{five@})\n"
"Explanation\n"
"@@end defblock\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13526
msgid ""
"macro body in case the @code{type} argument contains a space.  This example "
"produces the output below and enters an index entry for @code{F}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13530
msgid ""
"@linemacro deffunc {type, name, args} @deftypeline {Func} {\\type\\} \\n"
"ame\\ \\args\\"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13536
msgid ""
"@defblock @deffunc {long int} F (int @var{one}, int @var{two}, @ int "
"@var{three}, int @var{four}, int @var{five})  Explanation"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13542
msgid ""
"Line macros produce a whole number of lines of output in their expansion.  "
"There may be better compatibility between the Texinfo processors "
"(@command{texi2any} and @TeX{} with @file{texinfo.tex}) for macros defined "
"with @code{@@linemacro} than for those defined with @code{@@macro}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13544
#, no-wrap
msgid "@code{@@definfoenclose}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13546
msgid "@nodedescription Customized highlighting."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13546
#, no-wrap
msgid "@code{@@definfoenclose}: Customized Highlighting"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13549
#: texinfo/texinfo-ed.7.1-en_US.texi:13550
#, no-wrap
msgid "definfoenclose"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13549
#, no-wrap
msgid "Highlighting, customized"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13556
msgid ""
"An @code{@@definfoenclose} command may be used to define a highlighting "
"command for online output formats.  A command defined using "
"@code{@@definfoenclose} marks text by enclosing it in strings that precede "
"and follow the text."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13560
msgid ""
"In practice, there is little use for this command, and we do not recommend "
"you use it.  Support for @code{@@definfoenclose} may be removed in future "
"releases of Texinfo."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13567
msgid ""
"Write a @code{@@definfoenclose} command at the beginning of a line followed "
"by three comma-separated arguments.  The first argument to "
"@code{@@definfoenclose} is the @@-command name (without the @code{@@}); the "
"second argument is the start delimiter string; and the third argument is the "
"end delimiter string.  The latter two arguments enclose the highlighted text "
"in the output."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13573
msgid ""
"A delimiter string may contain spaces.  Neither the start nor end delimiter "
"is required.  If you do not want a start delimiter but do want an end "
"delimiter, you must follow the command name with two commas in a row; "
"otherwise, the end delimiter string you intended will naturally be "
"(mis)interpreted as the start delimiter string."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13576
msgid ""
"An enclosure command defined this way takes one argument in braces, since it "
"is intended for new markup commands (@pxref{Marking Text})."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13577
#, no-wrap
msgid "phoo"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13579
msgid "For example, you can write:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13582
#, no-wrap
msgid "@@definfoenclose phoo,//,\\\\\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13589
msgid ""
"near the beginning of a Texinfo file to define @code{@@phoo} as an Info and "
"HTML formatting command that inserts `//' before and `\\\\' after the "
"argument to @code{@@phoo}.  You can then write @code{@@phoo@{bar@}} wherever "
"you want `//bar\\\\' highlighted in Info and HTML."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13591
msgid "For @TeX{} formatting, you could write"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13596
#, no-wrap
msgid ""
"@@iftex\n"
"@@alias phoo = i\n"
"@@end iftex\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13601
msgid ""
"to define @code{@@phoo} as a command that causes @TeX{} to typeset the "
"argument to @code{@@phoo} in italics."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13610
msgid ""
"Each definition applies to its own formatter: one for @TeX{}, the other for "
"online formats.  The @TeX{} definitions need to be in @samp{@@iftex}.  "
"@code{@@definfoenclose} command need not be within @samp{@@ifinfo} unless "
"you want to use different definitions for different online output formats.  "
"@code{@@definfoenclose} defined commands have no effect in DocBook and "
"@LaTeX{} output, their argument is output as-is.  An @code{@@alias} could "
"also be used for these formats."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13613
msgid ""
"@code{@@definfoenclose} definitions must not be recursive, directly or "
"indirectly."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13615
#, no-wrap
msgid "External Macro Processors"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13617
msgid "@nodedescription @code{#line} directives."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13617
#, no-wrap
msgid "External Macro Processors: Line Directives"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13618
#, no-wrap
msgid "External macro processors"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13619
#, no-wrap
msgid "Macro processors, external"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13627
msgid ""
"Texinfo macros (and its other text substitution facilities) work fine in "
"straightforward cases.  If your document needs unusually complex processing, "
"however, their fragility and limitations can be a problem.  In this case, "
"you may want to use a different macro processor altogether, such as M4 "
"(@pxref{Top,,, m4, M4}) or CPP (@pxref{Top,,, cpp, The C Preprocessor})."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13635
msgid ""
"With one exception, Texinfo does not need to know whether its input is "
"``original'' source or preprocessed from some other source file.  Therefore, "
"you can arrange your build system to invoke whatever programs you like to "
"handle macro expansion or other preprocessing needs.  Texinfo does not offer "
"built-in support for any particular preprocessor, since no one program "
"seemed likely to suffice for the requirements of all documents."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13636
#, no-wrap
msgid "Line numbers, in error messages"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13637
#, no-wrap
msgid "Error messages, line numbers in"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13642
msgid ""
"The one exception is line numbers in error messages.  In that case, the line "
"number should refer to the original source file, whatever it may be.  "
"There's a well-known mechanism for this: the so-called @samp{#line} "
"directive.  Texinfo supports this."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:13644
#: texinfo/texinfo-ed.7.1-en_US.texi:13645
#, no-wrap
msgid "@samp{#line} Directive"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13647
#, no-wrap
msgid "@samp{#line} directive"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13650
msgid "An input line such as this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13653
#, no-wrap
msgid "@hashchar{}line 100 \"foo.ptexi\"\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13661
msgid ""
"@file{foo.ptexi}, and so that's what an error message should refer to.  Both "
"M4 (@pxref{Preprocessor features,,, m4, GNU M4}) and CPP (@pxref{Line "
"Control,,, cpp, The C Preprocessor}, and @ref{Preprocessor Output,,, cpp, "
"The C Preprocessor}) can generate such lines."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13667
msgid ""
"The @command{texi2any} program recognizes these lines by default, except "
"within @code{@@verbatim} blocks (@pxref{@code{@@verbatim}}).  Their "
"recognition can be turned off completely with @code{CPP_LINE_DIRECTIVES} "
"(@pxref{Other Customization Variables}), though there is normally no reason "
"to do so."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13673
msgid ""
"For those few programs (M4, CPP, Texinfo) which need to document "
"@samp{#line} directives and therefore have examples which would otherwise "
"match the pattern, the command @code{@@hashchar@{@}} can be used "
"(@pxref{Inserting a Hashsign}).  The example line above looks like this in "
"the source for this manual:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13676
#, no-wrap
msgid "@@hashchar@{@}line 100 \"foo.ptexi\"\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13681
msgid ""
"The @code{@@hashchar} command was added to Texinfo in 2013.  If you don't "
"want to rely on it, you can also use @code{@@set} and @code{@@value} to "
"insert the literal @samp{#}:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13685
#, no-wrap
msgid ""
"@@set hash #\n"
"@@value@{hash@}line 1 \"example.c\"\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13690
msgid ""
"Or, if suitable, a @code{@@verbatim} environment can be used instead of "
"@code{@@example}.  As mentioned above, @code{#line}-recognition is disabled "
"inside verbatim blocks."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:13692
#: texinfo/texinfo-ed.7.1-en_US.texi:13693
#, no-wrap
msgid "@samp{#line} and @TeX{}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13695
#, no-wrap
msgid "@TeX{} and @samp{#line} directives"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13696
#, no-wrap
msgid "@samp{#line} directive @subentry not processing with @TeX{}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13704
msgid ""
"As mentioned, @command{texi2any} recognizes the @samp{#line} directives "
"described in the previous section.  However, @file{texinfo.tex} does not and "
"cannot.  Therefore, such a line will be incorrectly typeset verbatim if "
"@TeX{} sees it.  The solution is to use @command{texi2any}'s macro expansion "
"options before running @TeX{}.  There are three approaches:"
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13711
msgid ""
"If you run @command{texi2dvi} or its variants (@pxref{Format with "
"@command{texi2dvi}}), you can pass @option{-E} and @command{texi2dvi} will "
"run @command{texi2any} first to expand macros and eliminate @samp{#line}."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13716
msgid ""
"If you run @command{texi2any}, you can specify @option{--no-ifinfo --iftex "
"-E somefile.out}, and then give @file{somefile.out} to @command{texi2dvi} in "
"a separate command."
msgstr ""

#. type: itemize
#: texinfo/texinfo-ed.7.1-en_US.texi:13721
msgid ""
"Or you can run @option{texi2any --dvi --Xopt -E}.  (Or @option{--pdf} "
"instead of @option{--dvi}.)  @command{texi2any} will then call "
"@command{texi2dvi -E}."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13723
#, no-wrap
msgid "errormsg@r{, and line numbers in @TeX{}}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13730
msgid ""
"One last caveat regarding use with @TeX{}: since the @code{#line} directives "
"are not recognized, the line numbers emitted by the @code{@@errormsg@{@}} "
"command (@pxref{Conditional Commands}), or by @TeX{} itself, are the "
"(incorrect) line numbers from the derived file which @TeX{} is reading, "
"rather than the preprocessor-specified line numbers."
msgstr ""

#. type: subsection
#: texinfo/texinfo-ed.7.1-en_US.texi:13732
#: texinfo/texinfo-ed.7.1-en_US.texi:13733
#, no-wrap
msgid "@samp{#line} Syntax Details"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13735
#, no-wrap
msgid "@samp{#line} directive @subentry syntax details"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13736
#, no-wrap
msgid "Syntax details, @samp{#line}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13737
#, no-wrap
msgid "Regular expression, for @samp{#line}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13745
msgid ""
"Syntax details for the @samp{#line} directive: the @samp{#} character can be "
"preceded or followed by whitespace, the word @samp{line} is optional, and "
"the file name can be followed by a whitespace-separated list of integers "
"(these are so-called ``flags'' output by CPP in some cases).  For those who "
"like to know the gory details, the actual (Perl) regular expression which is "
"matched is this:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13748
#, no-wrap
msgid "/^\\s*#\\s*(line)? (\\d+)(( \"([^\"]+)\")(\\s+\\d+)*)?\\s*$/\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13753
msgid ""
"As far as we've been able to tell, the trailing integer flags only occur in "
"conjunction with a file name, so that is reflected in the regular expression."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13756
msgid ""
"As an example, the following is a syntactically valid @samp{#line} "
"directive, meaning line 1 of @file{/usr/include/stdio.h}:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13759
#, no-wrap
msgid "@hashchar{} 1 \"/usr/include/stdio.h\" 2 3 4\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13765
msgid ""
"Unfortunately, the quoted file name (@samp{\"...\"}) has to be optional, "
"because M4 (especially) can often generate @samp{#line} directives within a "
"single file.  Since the @samp{line} is also optional, the result is that "
"lines might match which you wouldn't expect, e.g.,"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13768
#, no-wrap
msgid "@hashchar{} 1\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13771
msgid ""
"The possible solutions are described above (@pxref{@samp{#line} Directive})."
msgstr ""

#. type: chapter
#: texinfo/texinfo-ed.7.1-en_US.texi:13773
#: texinfo/texinfo-ed.7.1-en_US.texi:13775
#, no-wrap
msgid "Include Files"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13775
msgid "@nodedescription How to incorporate other Texinfo files."
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13777
#, no-wrap
msgid "Include files"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13784
msgid ""
"When a Texinfo processor sees an @code{@@include} command in a Texinfo file, "
"it processes the contents of the file named by the @code{@@include} and "
"incorporates them into the output files being created.  Include files thus "
"let you keep a single large document as a collection of conveniently small "
"parts."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13786
#, no-wrap
msgid "Using Include Files"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13788
msgid "@nodedescription How to use the @code{@@include} command."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13788
#, no-wrap
msgid "How to Use Include Files"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13790
#, no-wrap
msgid "include"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13795
msgid ""
"To include another file within a Texinfo file, write the @code{@@include} "
"command at the beginning of a line and follow it on the same line by the "
"name of a file to be included.  For example:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13798
#, no-wrap
msgid "@@include buffers.texi\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13804
msgid ""
"@code{@@value@{@var{var}@}} references are expanded on the @code{@@include} "
"line.  Other than that, the only @@-commands allowed are @code{@@@@}, "
"@code{@@@{}, @code{@@@}} and associated @@-commands such as "
"@code{@@atchar@{@}}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13813
msgid ""
"An included file should simply be a segment of text that you expect to be "
"included as is into the overall or @dfn{outer} Texinfo file; it should not "
"contain the standard beginning and end parts of a Texinfo file.  In "
"particular, you should not start an included file with a line saying "
"@samp{\\input texinfo}; if you do, that text is inserted into the output "
"file literally.  Likewise, you should not end an included file with a "
"@code{@@bye} command; nothing after @code{@@bye} is formatted."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13818
msgid ""
"In the long-ago past, you were required to write an @code{@@setfilename} "
"line at the beginning of an included file, but no longer.  Now, it does not "
"matter whether you write such a line.  If an @code{@@setfilename} line "
"exists in an included file, it is ignored."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13822
msgid ""
"GNU Emacs Texinfo mode provides @code{texinfo-multiple-files-update} to "
"update node pointers and master menu with multiple include files.  "
"@xref{Update Multiple Files}."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13824
#, no-wrap
msgid "Sample Include File"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13826
msgid ""
"@nodedescription A sample outer file with included files within it; and a "
"sample included file."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13826
#, no-wrap
msgid "Sample File with @code{@@include}"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13827
#, no-wrap
msgid "Sample @code{@@include} file"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13828
#, no-wrap
msgid "Include file sample"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13829
#, no-wrap
msgid "@code{@@include} file sample"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13833
msgid ""
"Here is an example of an outer Texinfo file with @code{@@include} files "
"within it:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13839
#, no-wrap
msgid ""
"@@settitle Include Example\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13845
#, no-wrap
msgid ""
"@@node Top\n"
"@@top Include Example\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13852
#, no-wrap
msgid ""
"@@include foo.texi\n"
"@@include bar.texi\n"
"@@include concept-index.texi\n"
"@@bye\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13856
msgid "An included file, such as @file{foo.texi}, might look like this:"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13861
#, no-wrap
msgid ""
"@@node First\n"
"@@chapter First Chapter\n"
"\n"
msgstr ""

#. type: group
#: texinfo/texinfo-ed.7.1-en_US.texi:13863
#, no-wrap
msgid "Contents of first chapter @dots{}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13867
msgid ""
"The full contents of @file{concept-index.texi} might be as simple as this:"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13882
msgid ""
"The outer Texinfo source file for @cite{The GNU Emacs Lisp Reference Manual} "
"is named @file{elisp.texi}.  This outer file has already contained a master "
"menu with 417 entries and a list of 41 @code{@@include} files."
msgstr ""

#. type: node
#: texinfo/texinfo-ed.7.1-en_US.texi:13884
#, no-wrap
msgid "@code{@@verbatiminclude}"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13886
msgid "@nodedescription Including a file verbatim."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:13886
#, no-wrap
msgid "@code{@@verbatiminclude} @var{file}: Include a File Verbatim"
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:13889
#, no-wrap
msgid "verbatiminclude"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13890
#, no-wrap
msgid "Verbatim, include file"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:13891
#, no-wrap
msgid "Including a file verbatim"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13895
msgid ""
"You can include the exact contents of a file in the document with the "
"@code{@@verbatiminclude} command:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13898
#, no-wrap
msgid "@@verbatiminclude @var{filename}\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13906
msgid ""
"The contents of @var{filename} is printed in a verbatim environment "
"(@pxref{@code{@@verbatim}}).  Generally, the file is printed exactly as it "
"is, with all special characters and white space retained.  No indentation is "
"added; if you want indentation, enclose the @code{@@verbatiminclude} within "
"@code{@@example} (@pxref{@code{@@example}})."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13911
msgid ""
"@code{@@value@{@var{var}@}} references are expanded on the "
"@code{@@verbatiminclude} line.  This makes it possible to include files in "
"other directories within a distribution, for instance:"
msgstr ""

#. type: example
#: texinfo/texinfo-ed.7.1-en_US.texi:13914
#, no-wrap
msgid "@@verbatiminclude @@value@{top_srcdir@}/NEWS\n"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13918
msgid "first place.)"
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13922
msgid ""
"Other than that, the only @@-commands allowed are @code{@@@@}, @code{@@@{}, "
"@code{@@@}} and associated @@-commands such as @code{@@atchar@{@}}."
msgstr ""

#. type: Plain text
#: texinfo/texinfo-ed.7.1-en_US.texi:13925
msgid ""
"For a method on printing the file contents in a smaller font size, see the "
"end of the section on @code{@@verbatim}."
msgstr ""

