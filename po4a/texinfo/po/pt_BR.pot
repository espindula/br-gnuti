#. type: itemx
#: texinfo/texinfo-ed.7.1-en_US.texi:20671
#, no-wrap
msgid "M-x texinfo-insert-@@item"
msgstr ""

#. type: table
#: texinfo/texinfo-ed.7.1-en_US.texi:20674
msgid ""
"Insert @code{@@item} and put the cursor at the beginning of the next line."
msgstr ""

#. type: findex
#: texinfo/texinfo-ed.7.1-en_US.texi:20675
#, no-wrap
