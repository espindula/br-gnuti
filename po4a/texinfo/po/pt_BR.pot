#: texinfo/texinfo-ed.7.1-en_US.texi:20636
msgid "@nodedescription How to insert frequently used @@-commands."
msgstr ""

#. type: section
#: texinfo/texinfo-ed.7.1-en_US.texi:20636
#, no-wrap
msgid "Inserting Frequently Used Commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:20637
#, no-wrap
msgid "Inserting frequently used commands"
msgstr ""

#. type: cindex
#: texinfo/texinfo-ed.7.1-en_US.texi:20638
#, no-wrap
