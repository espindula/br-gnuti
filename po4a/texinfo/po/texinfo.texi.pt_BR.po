#: texinfo/texinfo.texi:19016
msgid ""
"Begin a kind of example.  Like @code{@@example} (indent text, do not fill), "
"but do not select a new font.  Pair with @code{@@end display}.  "
"@xref{@code{@@display}}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19017
#, no-wrap
msgid "@@displaymath"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19019
msgid "Format a block of math in ``display'' format.  @xref{Inserting Math}."
msgstr ""

