msgstr "@nodedescription Como inserir reticências: @dots{} e @enddots{}"

#. type: subsection
#: texinfo/texinfo.texi:9657
#, no-wrap
msgid "@code{@@dots} (@dots{}) and @code{@@enddots} (@enddots{})"
msgstr "@code{@@dots} (@dots{}) e @code{@@enddots} (@enddots{})"

