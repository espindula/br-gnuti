#. type: enumerate
#: texinfo/texinfo.texi:12715
msgid "Write text for the title page, for people reading the printed manual:"
msgstr ""
"Escreva texto para a página de título, para pessoas leitoras do manual "
"impresso:"

#. type: group
#: texinfo/texinfo.texi:12727
#, no-wrap
msgid ""
"@@titlepage\n"
"@@title GNU Make\n"
"@@subtitle A Program for Directing Recompilation\n"
"@@subtitle Edition @@value@{EDITION@}, @dots{}\n"
"@@subtitle @@value@{UPDATE-MONTH@}\n"
"@@page\n"
"@@insertcopying\n"
"@dots{}\n"
"@@end titlepage\n"
msgstr ""
"@@titlepage\n"
"@@title GNU Make\n"
"@@subtitle Um Programa para Direcionar Recompilação\n"
"@@subtitle Edição @@value@{EDITION@}, @dots{}\n"
"@@subtitle @@value@{UPDATE-MONTH@}\n"
"@@page\n"
"@@insertcopying\n"
"@dots{}\n"
"@@end titlepage\n"

#. type: enumerate
#: texinfo/texinfo.texi:12733
msgid ""
"(On a printed cover, a date listing the month and the year looks less fussy "
"than a date listing the day as well as the month and year.)"
msgstr ""
"(Em uma capa impressa, uma data listando o mês e o ano parece menos "
"complicada que uma data listando o dia, bem como o mês e o ano.)"

#. type: enumerate
#: texinfo/texinfo.texi:12736
