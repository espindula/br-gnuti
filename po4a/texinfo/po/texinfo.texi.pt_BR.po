msgstr "Inserindo pontos"

#. type: cindex
#: texinfo/texinfo.texi:9663
#, no-wrap
msgid "Inserting ellipsis"
msgstr "Inserindo reticências"

#. type: cindex
#: texinfo/texinfo.texi:9664
#, no-wrap
msgid "Dots, inserting"
msgstr "Pontos, inserindo"

#. type: cindex
#: texinfo/texinfo.texi:9665
