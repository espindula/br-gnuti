#: texinfo/texinfo.texi:19051
#, no-wrap
msgid "@@email@{@var{address}[, @var{displayed-text}]@}"
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19054
#, no-wrap
msgid "@@emph@{@var{text}@}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19056
msgid "Emphasize @var{text}.  @xref{Emphasis, , Emphasizing Text}."
msgstr ""

