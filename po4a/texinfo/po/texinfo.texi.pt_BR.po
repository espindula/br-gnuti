#: texinfo/texinfo.texi:18925
msgid ""
"Format a description for a typed class variable in object-oriented "
"programming.  @xref{Definition Commands}, and @ref{Abstract Objects}."
msgstr ""

#. type: itemx
#: texinfo/texinfo.texi:18927
#, no-wrap
msgid ""
"@@deftypefnx @var{category} @var{data-type} @var{name} @var{arguments}@dots{}"
msgstr ""

