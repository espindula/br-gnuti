#: texinfo/texinfo.texi:19008
#, no-wrap
msgid "@@direntry"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19011
msgid ""
"Begin the Info directory menu entry for this file.  Pair with @code{@@end "
"direntry}.  @xref{Installing Dir Entries}."
msgstr ""

