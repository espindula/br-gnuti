msgstr "@nodedescription Saída gerada para papel, com @TeX{}."

#. type: chapter
#: texinfo/texinfo.texi:14048
#, no-wrap
msgid "Formatting and Printing with @TeX{}"
msgstr "Formatando e Imprimindo com @TeX{}"

#.  old name
#. type: anchor{#1}
#: texinfo/texinfo.texi:14051
msgid "Hardcopy"
msgstr "Hardcopy"

#. type: anchor{#1}
