#: texinfo/texinfo.texi:19020
#, no-wrap
msgid "@@dmn@{@var{dimension}@}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19022
msgid "Format a unit of measure, as in 12@dmn{pt}.  @xref{@code{@@dmn}}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19023
#, no-wrap
msgid "@@docbook"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19026
msgid ""
"Enter DocBook completely.  Pair with @code{@@end docbook}.  @xref{Raw "
"Formatter Commands}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19027
#, no-wrap
msgid "@@documentdescription"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19030
msgid ""
"Set the document description text, included in the HTML output.  Pair with "
"@code{@@end documentdescription}.  @xref{@code{@@documentdescription}}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19031
#, no-wrap
msgid "@@documentencoding @var{enc}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19034
msgid ""
"Declare the input encoding to be @var{enc}.  "
"@xref{@code{@@documentencoding}}."
msgstr ""

