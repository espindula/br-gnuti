#: texinfo/texinfo.texi:19039
#, no-wrap
msgid "@@dotaccent@{@var{c}@}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19042
msgid ""
"Generate a dot accent over the character @var{c}, as in @dotaccent{o}.  "
"@xref{Inserting Accents}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19043
#, no-wrap
msgid "@@dotless@{@var{i-or-j}@}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19046
msgid ""
"Generate dotless i (`@dotless{i}') and dotless j (`@dotless{j}').  "
"@xref{Inserting Accents}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:19047
#, no-wrap
msgid "@@dots@{@}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:19050
msgid "Generate an ellipsis, @samp{@dots{}}.  @xref{@code{@@dots}}."
msgstr ""

