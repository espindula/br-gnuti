"@@deftypemethodx @var{class} @var{data-type} @var{method-name} "
"@var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:18958
msgid ""
"Format a description for a typed method in object-oriented programming.  "
"@xref{Definition Commands}."
msgstr ""

#. type: itemx
#: texinfo/texinfo.texi:18960
#, no-wrap
msgid ""
"@@deftypeopx @var{category} @var{class} @var{data-type} @var{name} "
"@var{arguments}@dots{}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:18963
msgid ""
"Format a description for a typed operation in object-oriented programming.  "
"@xref{Definition Commands}, and @ref{Abstract Objects}."
msgstr ""

#. type: item
#: texinfo/texinfo.texi:18964
#, no-wrap
msgid "@@deftypevar @var{data-type} @var{variable-name}"
msgstr ""

#. type: itemx
#: texinfo/texinfo.texi:18965
#, no-wrap
msgid "@@deftypevarx @var{data-type} @var{variable-name}"
msgstr ""

#. type: table
#: texinfo/texinfo.texi:18969
msgid ""
"Format a description for a variable in a typed language.  The command is "
"equivalent to @samp{@@deftypevr Variable @dots{}}.  @xref{Definition "
"Commands}."
msgstr ""

