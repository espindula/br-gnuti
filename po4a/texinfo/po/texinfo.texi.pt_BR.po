msgstr "@nodedescription O símbolo de registrado(a) (R em um círculo)."

#. type: subsection
#: texinfo/texinfo.texi:9644
#, no-wrap
msgid "@code{@@registeredsymbol@{@}} (@registeredsymbol{})"
msgstr "@code{@@registeredsymbol@{@}} (@registeredsymbol{})"

