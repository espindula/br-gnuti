po-auto-trans() {
  local pot="" po="" wid=79
  
  # Substitui o eval por um parser seguro
  for arg in "${@}"; do
    case "${arg}" in
      pot=*) pot="${arg#*=}" ;;
      po=*)  po="${arg#*=}"  ;;
      wid=*) wid="${arg#*=}" ;;
    esac
  done

  [[ -z "${pot}" ]] && { echo "Uso: po-auto-trans pot=<arquivo>"; return 1; }
  : "${po:="${pot%.*}".pt_BR.po}"

  # Processamento...
  sed -r '/^msgid/{:a;N;s/\n"/+"/;ta;}' "${pot}" | while IFS= read -r line; do
    read -r field msg <<< "${line}"
    case "${field}" in
      msgid*)
        content="${msg%\"}"   # Remove aspas final
        content="${content#\"}" # Remove aspas inicial
        # ... lógica de tradução com a variável content ...
        trd=$(trans -b -j -no-auto -- "${content}" || echo "${content}")
        echo "msgid ""${msg}"""
        ;;
      msgstr*)
        # Lógica de impressão da msgstr...
        ;;
      *) echo "${line}" ;;
    esac
  done | tee "${po}"
}
